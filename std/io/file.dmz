const std = import("std");

pub const stdin: i32 = 0;
pub const stdout: i32 = 1;
pub const stderr: i32 = 2;

pub const O_RDONLY = 0;

pub fn open(name: *u8, flags: i32, mode: u32) -> i32 {
    return std.syscall.open(name, flags, mode);
}
pub fn write(fd: i32, buffer: *u8, count: usize) -> isize {
    return std.syscall.write(fd, buffer, count);
}
pub fn read(fd: i32, buffer: *u8, count: usize) -> isize {
    return std.syscall.read(fd, buffer, count);
}
pub fn close(fd: i32) -> i32 {
    return std.syscall.close(fd);
}

pub fn writeAll(fd: i32, buffer: *u8, count: usize) -> !usize {
    let writed = 0;
    let buf_slice = buffer[0..count];
    while (buf_slice.len > 0) {
        const ret = write(fd, buf_slice.ptr, buf_slice.len);
        if (ret < 0) {
            try std.errno.syscallError(ret);
        } else {
            if (ret == 0) {
                return writed;
            }
        }
        buf_slice = buf_slice[ret..buf_slice.len];
        writed += ret;
    }
    return writed;
}

pub fn readOne(fd: i32, buffer: []u8) -> !usize {
    // std.io.printf("fd %d to readAll %ld\n", fd, buffer.len);
    const readed = read(fd, buffer.ptr, buffer.len);
    // std.io.printf("readed %d\n", readed);
    if (readed < 0) {
        try std.errno.syscallError(readed);
    }
    return readed;
}

pub const reader = struct {
    fd: i32,

    pub fn init(file_fd: i32) -> @This {
        return @This{
            fd: file_fd,
        };
    }

    pub fn reader(self: *@This, buf: []u8) -> std.io.Reader {
        let ret = std.io.Reader{
            buffer: buf,
            vtable_ptr: null,
            vtable_refill: &reader.refill,
        };
        ret.vtable_ptr = self;
        return ret;
    }

    fn refill(ptr: *@This, r: *std.io.Reader, wanted: usize) -> !usize {
        // std.io.printf("reader refill %ld\n", wanted);
        let readed = try std.io.file.readOne(ptr.fd, r.buffer[r.end..(r.end + wanted)]);
        // std.io.printf("readAll %ld\n", readed);
        r.end += readed;
        return readed;
    }
};