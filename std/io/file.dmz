const std = import("std");

pub const stdin: i32 = 0;
pub const stdout: i32 = 1;
pub const stderr: i32 = 2;

pub const O_RDONLY = 0;

pub fn open(name: *u8, flags: i32, mode: u32) -> !i32 {
    const ret = std.syscall.open(name, @intCast(flags), mode);
    if (ret < 0) {
        try std.errno.syscallError(ret);
    }
    return @intCast(ret);
}

pub fn write(fd: i32, buffer: []u8) -> !usize {
    const ret = std.syscall.write(fd, @ptrCast(buffer.ptr), buffer.len);
    if (ret < 0) {
        try std.errno.syscallError(ret);
    }
    return @intCast(ret);
}

pub fn read(fd: i32, buffer: []u8) -> !usize {
    const ret = std.syscall.read(fd, @ptrCast(buffer.ptr), buffer.len);
    if (ret < 0) {
        try std.errno.syscallError(ret);
    }
    return @intCast(ret);
}

pub fn close(fd: i32) -> !void {
    const ret = std.syscall.close(fd);
    if (ret < 0) {
        try std.errno.syscallError(ret);
    }
    return;
}

pub fn writeAll(fd: i32, buffer: []u8) -> !usize {
    let writed: usize = 0;
    let buf_slice = buffer;
    while (buf_slice.len > 0) {
        const ret = try write(fd, buf_slice);
        if (ret == 0) {
            return writed;
        }
        buf_slice = buf_slice[ret..buf_slice.len];
        writed += ret;
    }
    return writed;
}

pub fn readOne(fd: i32, buffer: []u8) -> !usize {
    return try read(fd, buffer);
}

pub const reader = struct {
    fd: i32,

    pub fn init(file_fd: i32) -> @This {
        return @This{
            fd: file_fd,
        };
    }

    pub fn reader(self: *@This, buf: []u8) -> std.io.Reader {
        let ret = std.io.Reader{
            buffer: buf,
            vtable_ptr: null,
            vtable_refill: @ptrCast(&reader.refill),
        };
        ret.vtable_ptr = @ptrCast(self);
        return ret;
    }

    fn refill(ptr: *@This, r: *std.io.Reader, wanted: usize) -> !usize {
        // std.io.printf("reader refill %ld\n", wanted);
        let readed = try std.io.file.readOne(ptr.fd, r.buffer[r.end..(r.end + wanted)]);
        // std.io.printf("readAll %ld\n", readed);
        r.end += readed;
        return readed;
    }
};