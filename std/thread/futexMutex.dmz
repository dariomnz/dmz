const std = import("std");

extern fn syscall(number: i64, ...) -> i64;

const SYS_futex: i64 = 202;
const FUTEX_WAIT = 0;
const FUTEX_WAKE = 1;
// Wrapper for the syscall
fn futex(uaddr: *i32, futex_op: i32, val: i32) -> i64 {
    return syscall(SYS_futex, uaddr, futex_op, val, null, null, 0);
}

pub const FutexMutex = struct {
    state: i32 = 0,
    // 0: free, 1: locked, 2: contention

    pub fn trylock(self: *@This) -> bool {
        let expected: i32 = 0;
        // Try to pass from 0 (free) to 1 (locked)
        // If m->state is not 0, the function returns false immediately
        if (@atomicCmpExS(&self.state, expected, 1)) {
            // Success: we have the lock
            return true;
        }

        // Failure: the mutex was already occupied (state 1 or 2)
        return false;
    }

    pub fn lock(self: *@This) -> !void {
        // Try the "Fast Path"
        if (self.trylock()) {
            return;
        }

        // If it failed, there is contention
        while (@atomicRmw(&self.state, .Xchg, 2) != 0) {
            // Sleep if the value is still 2
            futex(&self.state, FUTEX_WAIT, 2);
        }
    }

    pub fn unlock(self: *@This) -> !void {
        // If the value was 1, no one was waiting
        if (@atomicRmw(&self.state, .Sub, 1) != 1) {
            // There was contention, set to 0 and wake one
            @atomicStore(&self.state, 0);
            futex(&self.state, FUTEX_WAKE, 1);
        }
    }
};

test "thread futex mutex" {
    let contador = 0;
    let contador_ptr = &contador;
    const INCREMENTOS = 100000;
    let cont_mutex = FutexMutex{};
    let cont_mutex_ptr = &cont_mutex;

    const incrementar_contador = struct {
        contador_ptr: *i32,
        cont_mutex_ptr: *FutexMutex,
        pub fn call(arg: *@This) -> void {
            for (0..INCREMENTOS) |i| {
                try arg.cont_mutex_ptr.lock();
                arg.contador_ptr.*++;
                try arg.cont_mutex_ptr.unlock();
            }
        }
    };
    const c = incrementar_contador{contador_ptr: contador_ptr, cont_mutex_ptr: cont_mutex_ptr};

    const NUM_HILOS = 5;
    let threads: std.thread.Thread[NUM_HILOS] = {};

    for (0..NUM_HILOS) |i| {
        threads[i] = try std.thread.Thread.init(&incrementar_contador.call, &c);
    }

    for (0..NUM_HILOS) |i| {
        try threads[i].join();
    }

    try std.testing.expectEqual(NUM_HILOS * INCREMENTOS, contador);
}