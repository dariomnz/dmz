const std = import("std");

extern fn pthread_create(thread_id: *usize, attr: *void, start_routine: *fn(*void)->void, arg: *void) -> i32;
extern fn pthread_join(thread_id: usize, retval: *void) -> i32;
extern fn pthread_exit(retval: *void) -> void;

pub const Thread = struct {
    thread_id: usize = {},

    pub fn init(start_routine: *fn(*void)->void, arg: *void) -> !Thread {
        const this = @This{};
        const ret = pthread_create(&this.thread_id, null, start_routine, arg);
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
        return this;
    }

    pub fn join(self: *@This) -> !void {
        const ret = pthread_join(self.thread_id, null);
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }
};

test "thread test" {

    const worker = struct {
        id: i32,
        pub fn call(arg: *@This) -> void {
            std.io.printf("Thread %d\n", arg.id);
            pthread_exit(null);
        }
    };
    const t1 = try Thread.init(@ptrCast(&worker.call), @ptrCast(&worker{id: 1}));
    const t2 = try Thread.init(@ptrCast(&worker.call), @ptrCast(&worker{id: 2}));
    t1.join();
    t2.join();
}