
const std = import("std");

extern fn pthread_barrier_init(barrier: *void, attr: *void, count: u32) -> i32;
extern fn pthread_barrier_wait(barrier: *void) -> i32;
extern fn pthread_barrier_destroy(barrier: *void) -> i32;

pub const Barrier = struct {
    opaque_data: [32]u8 = {},

    pub fn init(count: u32) -> Barrier {
        const this = @This{};
        const ret = pthread_barrier_init(@ptrCast(&this.opaque_data), null, count);
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
        return this;
    }

    pub fn deinit(self: *@This) -> !void {
        const ret = pthread_barrier_destroy(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }

    pub fn wait(self: *@This) -> !void {
        const ret = pthread_barrier_wait(@ptrCast(&self.opaque_data));
        if (ret < -1) {
            try std.errno.syscallError(-ret);
        }
    }
};

test "barrier test" {
    const num_threads = 5;
    const barrier = Barrier.init(num_threads);
    defer barrier.deinit();
    const barrier_ptr = &barrier;
    const worker = struct {
        barrier_ptr: *Barrier,
        pub fn run(arg: *@This) -> void {
            std.io.printf("Worker: Before barrier.\n");
            try arg.barrier_ptr.wait();
            std.io.printf("Worker: After barrier.\n");
        }
    };
    let threads: [num_threads]std.thread.Thread = {};
    const c = worker{barrier_ptr: &barrier};
    for (0..num_threads) |i| {
        threads[i] = try std.thread.Thread.init(@ptrCast(&worker.run), @ptrCast(&c));
    }
    for (0..num_threads) |i| {
        try threads[i].join();
    }
}