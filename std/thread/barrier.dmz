
const std = import("std");

extern fn pthread_barrier_init(barrier: *void, attr: *void, count: u32) -> i32;
extern fn pthread_barrier_wait(barrier: *void) -> i32;
extern fn pthread_barrier_destroy(barrier: *void) -> i32;

pub struct Barrier {
    opaque_data: u8[32] = {},

    pub fn init(count: u32) -> Barrier {
        const this = @This{};
        const ret = pthread_barrier_init(&this.opaque_data, null, count);
        if (ret != 0) {
            try std.errno.libc_error(ret);
        }
        return this;
    }

    pub fn deinit(self: *@This) -> !void {
        const ret = pthread_barrier_destroy(&self.opaque_data);
        if (ret != 0) {
            try std.errno.libc_error(ret);
        }
    }

    pub fn wait(self: *@This) -> !void {
        const ret = pthread_barrier_wait(&self.opaque_data);
        if (ret != 0) {
            try std.errno.libc_error(ret);
        }
    }
}

test "barrier test" {
    const num_threads = 10;
    const barrier = Barrier.init(num_threads);
    defer barrier.deinit();
    const barrier_ptr = &barrier;
    const worker = [barrier_ptr](arg: *void) -> void {
        std.io.printf("Worker: Before barrier.\n");
        barrier_ptr.wait();
        std.io.printf("Worker: After barrier.\n");
    };
    let threads: std.thread.Thread[num_threads] = {};
    for (0..num_threads) |i| {
        threads[i] = try std.thread.Thread.init(worker, null);
    }
    for (0..num_threads) |i| {
        try threads[i].join();
    }
}