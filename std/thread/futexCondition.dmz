const std = import("std");

const SYS_futex: i64 = 202;
const FUTEX_WAIT = 0;
const FUTEX_WAKE = 1;
const FUTEX_CMP_REQUEUE = 4;

extern fn syscall(number: i64, ...) -> i64;

fn futex(uaddr: *i32, futex_op: i32, val: i32) -> i64 {
    return syscall(SYS_futex, uaddr, futex_op, val, null, null, 0);
}

pub struct FutexCondition {
    sequence: i32 = 0,

    pub fn wait(self: *@This, mutex: *std.thread.FutexMutex) -> !void {
        let current_sequence = @atomicLoad(&self.sequence);
        mutex.unlock();
        futex(&self.sequence, FUTEX_WAIT, current_sequence);
        mutex.lock();
    }

    pub fn notifyOne(self: *@This) -> !void {
        @atomicRmw(&self.sequence, +, 1);
        futex(&self.sequence, FUTEX_WAKE, 1);
    }

    pub fn notifyAll(self: *@This) -> !void {
        @atomicRmw(&self.sequence, +, 1);
        futex(&self.sequence, FUTEX_WAKE, 2147483647);
    }
}

