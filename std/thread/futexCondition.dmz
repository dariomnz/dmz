const std = import("std");

const SYS_futex: i64 = 202;
const FUTEX_WAIT = 0;
const FUTEX_WAKE = 1;
const FUTEX_CMP_REQUEUE = 4;

extern fn syscall(number: i64, ...) -> i64;

fn futex(uaddr: *i32, futex_op: i32, val: i32) -> i64 {
    return syscall(SYS_futex, uaddr, futex_op, val, null, null, 0);
}

pub const FutexCondition = struct {
    sequence: i32 = 0,

    pub fn wait(self: *@This, mutex: *std.thread.FutexMutex) -> !void {
        let current_sequence = @atomicLoad(&self.sequence);
        mutex.unlock();
        futex(&self.sequence, FUTEX_WAIT, current_sequence);
        mutex.lock();
    }

    pub fn notifyOne(self: *@This) -> !void {
        @atomicRmw(&self.sequence, .Add, 1);
        futex(&self.sequence, FUTEX_WAKE, 1);
    }

    pub fn notifyAll(self: *@This) -> !void {
        @atomicRmw(&self.sequence, .Add, 1);
        futex(&self.sequence, FUTEX_WAKE, 2147483647);
    }
};


test "conditional variable test" {

    const test_ctx = struct {
        m: *std.thread.FutexMutex,
        cv: *std.thread.FutexCondition,
        ready: *i32,
    };

    let m = std.thread.FutexMutex{};
    let cv = std.thread.FutexCondition{};
    let ready = 0;
    let ctx_value = test_ctx{
        m: &m,
        cv: &cv,
        ready: &ready,
    };

    const worker = struct {
        pub fn run(ctx: *test_ctx) -> void {
            ctx.m.lock();

            while (ctx.ready.* == 0) {
                std.io.printf("Worker: There are no tasks, I'm going to sleep...\n");
                // Se suelta el mutex y espera la señal
                ctx.cv.wait(ctx.m);
            }

            std.io.printf("Worker: I was woken up! Time to work.\n");
            ctx.m.unlock();
        }
    };

    const boss = struct {
        pub fn run(ctx: *test_ctx) -> void {
            std.thread.sleep(100);
            ctx.m.lock();

            ctx.ready.* = 1;
            std.io.printf("Boss: Task ready. Wake up!\n");
            ctx.cv.notifyOne();
            ctx.m.unlock();
        }
    };

    const t1 = try std.thread.Thread.init(&worker.run, &ctx_value);
    const t2 = try std.thread.Thread.init(&boss.run, &ctx_value);
    try t1.join();
    try t2.join();
}