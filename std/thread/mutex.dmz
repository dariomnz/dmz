
const std = import("std");

extern fn pthread_mutex_init(mutexPtr: *void, attr: *void) -> i32;
extern fn pthread_mutex_lock(mutexPtr: *void) -> i32;
extern fn pthread_mutex_unlock(mutexPtr: *void) -> i32;
extern fn pthread_mutex_destroy(mutexPtr: *void) -> i32;

pub const Mutex = struct {
    opaque_data: [40]u8 = {},

    pub fn init() -> Mutex {
        const this = @This{};
        const ret = pthread_mutex_init(@ptrCast(&this.opaque_data), null);
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
        return this;
    }

    pub fn deinit(self: *@This) -> !void {
        const ret = pthread_mutex_destroy(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }

    pub fn lock(self: *@This) -> !void {
        const ret = pthread_mutex_lock(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }

    pub fn unlock(self: *@This) -> !void {
        const ret = pthread_mutex_unlock(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }
};

test "mutex test" {
    let m = Mutex.init();
    defer m.deinit();
    m.lock();
    m.unlock();
}