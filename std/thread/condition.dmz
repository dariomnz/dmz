
const std = import("std");

extern fn pthread_cond_init(cond: *void, attr: *void) -> i32;
extern fn pthread_cond_signal(cond: *void) -> i32;
extern fn pthread_cond_broadcast(cond: *void) -> i32;
extern fn pthread_cond_wait(cond: *void, mutex: *void) -> i32;
extern fn pthread_cond_destroy(cond: *void) -> i32;

pub const Condition = struct {
    opaque_data: [48]u8 = {},

    pub fn init() -> Condition {
        const this = @This{};
        const ret = pthread_cond_init(@ptrCast(&this), null);
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
        return this;
    }

    pub fn deinit(self: *@This) -> !void {
        const ret = pthread_cond_destroy(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }

    pub fn wait(self: *@This, mutex: *std.thread.Mutex) -> !void {
        const ret = pthread_cond_wait(@ptrCast(&self.opaque_data), @ptrCast(&mutex.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }

    pub fn notifyOne(self: *@This) -> !void {
        const ret = pthread_cond_signal(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }

    pub fn notifyAll(self: *@This) -> !void {
        const ret = pthread_cond_broadcast(@ptrCast(&self.opaque_data));
        if (ret != 0) {
            try std.errno.syscallError(ret);
        }
    }
};

test "conditional variable test" {

    const test_ctx = struct {
        m: *std.thread.Mutex,
        cv: *std.thread.Condition,
        ready: *i32,
    };

    let m = std.thread.Mutex.init();
    defer m.deinit();
    let cv = std.thread.Condition.init();
    defer cv.deinit();
    let ready = 0;
    let ctx_value = test_ctx{
        m: &m,
        cv: &cv,
        ready: &ready,
    };

    const worker = struct {
        pub fn run(ctx: *test_ctx) -> void {
            ctx.m.lock();

            while (ctx.ready.* == 0) {
                std.io.printf("Worker: There are no tasks, I'm going to sleep...\n");
                // Se suelta el mutex y espera la señal
                ctx.cv.wait(ctx.m);
            }

            std.io.printf("Worker: I was woken up! Time to work.\n");
            ctx.m.unlock();
        }
    };

    const boss = struct {
        pub fn run(ctx: *test_ctx) -> void {
            std.thread.sleep(100);
            ctx.m.lock();

            ctx.ready.* = 1;
            std.io.printf("Boss: Task ready. Wake up!\n");
            ctx.cv.notifyOne();
            ctx.m.unlock();
        }
    };

    const t1 = try std.thread.Thread.init(@ptrCast(&worker.run), @ptrCast(&ctx_value));
    const t2 = try std.thread.Thread.init(@ptrCast(&boss.run), @ptrCast(&ctx_value));
    try t1.join();
    try t2.join();
}