pub const Mutex = import("./thread/mutex.dmz").Mutex;
pub const Thread = import("./thread/thread.dmz").Thread;
pub const Condition = import("./thread/condition.dmz").Condition;

pub const FutexMutex = import("./thread/futexMutex.dmz").FutexMutex;
pub const FutexCondition = import("./thread/futexCondition.dmz").FutexCondition;

pub fn sleep(ms: u32) -> !void {
    const time = std.syscall.TimeSpec{tv_sec: 0, tv_nsec: ms * 1000 * 1000};
    const result = std.syscall.nanosleep(&time, @ptrCast(null));
    if (result != 0) {
        return std.errno.syscallError(result);
    }
}

const std = import("std");

test "thread mutex" {
    let contador = 0;
    let contador_ptr = &contador;
    const INCREMENTOS = 100000;
    let cont_mutex = Mutex.init();
    defer try cont_mutex.deinit();
    let cont_mutex_ptr = &cont_mutex;

    const incrementar_contador = struct {
        contador_ptr: *i32,
        cont_mutex_ptr: *Mutex,
        pub fn call(arg: *@This) -> void {
            for (0..INCREMENTOS) |i| {
                try arg.cont_mutex_ptr.lock();
                arg.contador_ptr.*++;
                try arg.cont_mutex_ptr.unlock();
            }
        }
    };
    const c = incrementar_contador{contador_ptr: contador_ptr, cont_mutex_ptr: cont_mutex_ptr};

    const NUM_HILOS = 5;
    let threads: [NUM_HILOS]Thread = {};

    for (0..NUM_HILOS) |i| {
        threads[i] = try Thread.init(@ptrCast(&incrementar_contador.call), @ptrCast(&c));
    }

    for (0..NUM_HILOS) |i| {
        try threads[i].join();
    }

    try std.testing.expectEqual(i32, NUM_HILOS * INCREMENTOS, contador);
}

test "thread atomic" {
    let contador = 0;
    let contador_ptr = &contador;
    const INCREMENTOS = 100000;
    const incrementar_contador = struct {
        contador_ptr: *i32,
        pub fn call(arg: *@This) -> void {
            for (0..INCREMENTOS) |i| {
                @atomicRmw(arg.contador_ptr, .Add, 1);
            }
        }
    };
    const c = incrementar_contador{contador_ptr: contador_ptr};

    const NUM_HILOS = 5;
    let threads: [NUM_HILOS]Thread = {};

    for (0..NUM_HILOS) |i| {
        threads[i] = try Thread.init(@ptrCast(&incrementar_contador.call), @ptrCast(&c));
    }

    for (0..NUM_HILOS) |i| {
        try threads[i].join();
    }

    try std.testing.expectEqual(i32, NUM_HILOS * INCREMENTOS, contador);
}