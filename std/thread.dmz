pub const Mutex = import("./thread/mutex.dmz").Mutex;
pub const Thread = import("./thread/thread.dmz").Thread;
pub const Condition = import("./thread/condition.dmz").Condition;

pub const FutexMutex = import("./thread/futexMutex.dmz").FutexMutex;
pub const FutexCondition = import("./thread/futexCondition.dmz").FutexCondition;

extern fn usleep(useconds: u32) -> i32;

pub fn sleep(ms: u32) -> !void {
    const result = usleep(ms * 1000);
    if (result != 0) {
        return std.errno.libc_errno();
    }
}

const std = import("std");

test "thread mutex" {
    let contador = 0;
    let contador_ptr = &contador;
    const INCREMENTOS = 100000;
    let cont_mutex = Mutex.init();
    defer try cont_mutex.deinit();
    let cont_mutex_ptr = &cont_mutex;
    const incrementar_contador = [contador_ptr, INCREMENTOS, cont_mutex_ptr](arg: *void) -> void { for (0..INCREMENTOS) |i| {
        try cont_mutex_ptr.lock();
        contador_ptr.*++;
        try cont_mutex_ptr.unlock();
    } };

    const NUM_HILOS = 5;
    let threads: Thread[NUM_HILOS] = {};

    for (0..NUM_HILOS) |i| {
        threads[i] = try Thread.init(incrementar_contador, null);
    }

    for (0..NUM_HILOS) |i| {
        try threads[i].join();
    }

    try std.testing.expectEqual(NUM_HILOS * INCREMENTOS, contador);
}

test "thread atomic" {
    let contador = 0;
    let contador_ptr = &contador;
    const INCREMENTOS = 100000;
    const incrementar_contador = [contador_ptr, INCREMENTOS](arg: *void) -> void { for (0..INCREMENTOS) |i| {
        @atomicRmw(contador_ptr, +, 1);
    } };

    const NUM_HILOS = 5;
    let threads: Thread[NUM_HILOS] = {};

    for (0..NUM_HILOS) |i| {
        threads[i] = try Thread.init(incrementar_contador, null);
    }

    for (0..NUM_HILOS) |i| {
        try threads[i].join();
    }

    try std.testing.expectEqual(NUM_HILOS * INCREMENTOS, contador);
}