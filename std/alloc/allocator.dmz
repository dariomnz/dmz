const std = import("std");

pub const Allocator = struct {
    allocator: *void,

    pub const VTable = struct {
        malloc: *fn(*void, usize)->![]u8,
        realloc: *fn(*void, []u8, usize)->![]u8,
        free: *fn(*void, []u8)->void,
    };

    vtable: VTable,

    pub fn malloc<T>(self: *@This, count: usize) -> ![]T {
        const newSlice = try self.vtable.malloc(self.allocator, count * @sizeof(T));
        return std.mem.bytesAsSlice<T>(newSlice);
    }

    pub fn realloc<T>(self: *@This, ptr: []T, count: usize) -> ![]T {
        const newSlice = try self.vtable.realloc(self.allocator, std.mem.sliceAsBytes<T>(ptr), count * @sizeof(T));
        return std.mem.bytesAsSlice<T>(newSlice);
    }

    pub fn free<T>(self: *@This, ptr: []T) -> void {
        self.vtable.free(self.allocator, std.mem.sliceAsBytes<T>(ptr));
    }
};