const std = import("std");
const Allocator = std.mem.Allocator;

extern fn malloc(size: usize) -> *void;
extern fn realloc(ptr: *void, size: usize) -> *void;
extern fn free(ptr: *void) -> void;

pub const LibcAllocator = struct {
    allocated: usize,
    allocated_count: usize,

    pub fn init() -> @This {
        return @This{
            allocated: 0,
            allocated_count: 0,
        };
    }

    pub fn deinit(self: *@This) -> !void {
        if (self.allocated_count != 0) {
            return error.LeakMemory;
        }
    }

    fn malloc(self: *@This, size: usize) -> ![]u8 {
        self.allocated += size;
        self.allocated_count++;
        const ptr = malloc(size);
        if (ptr == null) return error.OutOfMemory;
        let slice: []u8 = {};
        slice.ptr = @ptrCast(ptr);
        slice.len = size;
        return slice;
    }

    fn realloc(self: *@This, ptr: []u8, size: usize) -> ![]u8 {
        self.allocated -= ptr.len;
        self.allocated += size;
        const raw = realloc(@ptrCast(ptr.ptr), size);
        if (raw == null) return error.OutOfMemory;
        let slice: []u8 = {};
        slice.ptr = @ptrCast(raw);
        slice.len = size;
        return slice;
    }

    fn free(self: *@This, ptr: []u8) -> void {
        self.allocated_count--;
        free(@ptrCast(ptr.ptr));
    }

    pub fn Allocator(self: *@This) -> Allocator {
        return Allocator{
            allocator: @ptrCast(self),
            vtable: Allocator.VTable{
                malloc: @ptrCast(&self.malloc),
                realloc: @ptrCast(&self.realloc),
                free: @ptrCast(&self.free),
            },
        };
    }
};

test "LibcAllocator basic" {
    let allocator = LibcAllocator.init();
    defer allocator.deinit();
    const a = allocator.Allocator();
    const b = try a.malloc(u8, 10);
    std.io.print("Malloc {d} bytes\n", .{b.len});
    std.io.print("Allocated {d} bytes\n", .{allocator.allocated});
    const c = try a.realloc(u8, b, 20);
    std.io.print("Realloc {d} bytes\n", .{c.len});
    std.io.print("Allocated {d} bytes\n", .{allocator.allocated});
    defer a.free(u8, c);
    std.io.print("Free {d} bytes\n", .{c.len});
    std.io.print("Allocated {d} bytes\n", .{allocator.allocated});
}