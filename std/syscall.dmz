const std = import("std");

pub fn syscall(sys: Syscall) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax}", number);
    return ret;
}

pub fn syscall1(sys: Syscall, arg1: usize) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax},{rdi}", number, arg1);
    return ret;
}

pub fn syscall2(sys: Syscall, arg1: usize, arg2: usize) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax},{rdi},{rsi}", number, arg1, arg2);
    return ret;
}

pub fn syscall3(sys: Syscall, arg1: usize, arg2: usize, arg3: usize) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax},{rdi},{rsi},{rdx}", number, arg1, arg2, arg3);
    return ret;
}

pub fn syscall4(sys: Syscall, arg1: usize, arg2: usize, arg3: usize, arg4: usize) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax},{rdi},{rsi},{rdx},{rcx}", number, arg1, arg2, arg3, arg4);
    return ret;
}

pub fn syscall5(sys: Syscall, arg1: usize, arg2: usize, arg3: usize, arg4: usize, arg5: usize) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax},{rdi},{rsi},{rdx},{rcx},{r8}", number, arg1, arg2, arg3, arg4, arg5);
    return ret;
}

pub fn syscall6(sys: Syscall, arg1: usize, arg2: usize, arg3: usize, arg4: usize, arg5: usize, arg6: usize) -> isize {
    const number: usize = sys;
    let ret: isize = @asm("syscall", "={rax},{rax},{rdi},{rsi},{rdx},{rcx},{r8},{r9}", number, arg1, arg2, arg3, arg4, arg5, arg6);
    return ret;
}

pub const Syscall = enum {
    read = 0,
    write = 1,
    open = 2,
    close = 3,
    stat = 4,
    fstat = 5,
    lstat = 6,
    poll = 7,
    lseek = 8,
    mmap = 9,
    mprotect = 10,
    munmap = 11,
    brk = 12,
    rt_sigaction = 13,
    rt_sigprocmask = 14,
    rt_sigreturn = 15,
    ioctl = 16,
    pread64 = 17,
    pwrite64 = 18,
    readv = 19,
    writev = 20,
    access = 21,
    pipe = 22,
    select = 23,
    sched_yield = 24,
    mremap = 25,
    msync = 26,
    mincore = 27,
    madvise = 28,
    shmget = 29,
    shmat = 30,
    shmctl = 31,
    dup = 32,
    dup2 = 33,
    pause = 34,
    nanosleep = 35,
    getitimer = 36,
    alarm = 37,
    setitimer = 38,
    getpid = 39,
    sendfile = 40,
    socket = 41,
    connect = 42,
    accept = 43,
    sendto = 44,
    recvfrom = 45,
    sendmsg = 46,
    recvmsg = 47,
    shutdown = 48,
    bind = 49,
    listen = 50,
    getsockname = 51,
    getpeername = 52,
    socketpair = 53,
    setsockopt = 54,
    getsockopt = 55,
    clone = 56,
    fork = 57,
    vfork = 58,
    execve = 59,
    exit = 60,
    wait4 = 61,
    kill = 62,
    futex = 202,
};

pub fn read(fd: i32, buf: *u8, count: usize) -> isize {
    return syscall3(.read, @intCast(fd), buf, count);
}

pub fn write(fd: i32, buf: *u8, count: usize) -> isize {
    return syscall3(.write, @intCast(fd), buf, count);
}

pub fn open(name: *u8, flags: usize, mode: usize) -> isize {
    return syscall3(.open, name, flags, mode);
}

pub fn close(fd: i32) -> isize {
    return syscall1(.close, @intCast(fd));
}

pub fn ioctl(fd: i32, request: usize, arg: *void) -> isize {
    return syscall3(.ioctl, @intCast(fd), request, arg);
}

pub const TimeSpec = struct {
    tv_sec: i64,
    tv_nsec: i64,
};

pub fn nanosleep(req: *TimeSpec, rem: *TimeSpec) -> isize {
    return syscall2(.nanosleep, req, rem);
}

pub const FutexOp = enum {
    wait = 0,
    wake = 1,
};

pub fn futex(uaddr: *i32, futex_op: FutexOp, val: i32) -> i64 {
    return syscall3(.futex, uaddr, futex_op, @intCast(val));
}

pub const PROT = struct {
    const NONE = 0;
    const READ = 1 << 0;
    const WRITE = 1 << 1;
    const EXECUTE = 1 << 2;
};

pub const MAP = struct {
    const SHARED = 1 << 0;
    const PRIVATE = 1 << 1;
    const FIXED = 1 << 4;
    const ANONYMOUS = 1 << 5;
};

pub fn mmap(addr: *void, length: usize, prot: usize, flags: usize, fd: i32, offset: usize) -> !*void {
    const ret = syscall6(.mmap, addr, length, prot, flags, @intCast(fd), offset);
    if (ret < 0) try std.errno.syscallError(@intCast(ret));
    return ret;
}

pub fn munmap(addr: *void, length: usize) -> isize {
    return syscall2(.munmap, addr, length);
}

pub fn exit(code: i32) -> void {
    syscall1(.exit, @intCast(code));
}