pub fn bubbleSort<T>(slice: []T, cmp: *fn(T, T)->bool) -> void {
    if (slice.len == 0) {
        return;
    }
    let n = slice.len;
    for (0..(n - 1)) |i| {
        for (0..(n - i - 1)) |j| {
            if (cmp(slice[j + 1], slice[j])) {
                let temp = slice[j];
                slice[j] = slice[j + 1];
                slice[j + 1] = temp;
            }
        }
    }
}

fn swap<T>(slice: []T, a: usize, b: usize) -> void {
    let temp = slice[a];
    slice[a] = slice[b];
    slice[b] = temp;
}

pub fn quickSort<T>(slice: []T, cmp: *fn(T, T)->bool) -> void {
    if (slice.len < 2) {
        return;
    }
    const mid = slice.len / 2;
    const last = slice.len - 1;

    if (cmp(slice[mid], slice[0])) {
        swap<T>(slice, 0, mid);
    }
    if (cmp(slice[last], slice[0])) {
        swap<T>(slice, 0, last);
    }
    if (cmp(slice[last], slice[mid])) {
        swap<T>(slice, mid, last);
    }
    swap<T>(slice, mid, last);

    const piv_idx = slice.len - 1;
    // const piv_idx = slice.len / 2;

    let piv = slice[piv_idx];
    let i: usize = 0;

    for (0..piv_idx) |j| {
        if (cmp(slice[j], piv)) {
            swap<T>(slice, i, j);
            i++;
        }
    }
    swap<T>(slice, i, piv_idx);

    quickSort<T>(slice[0..i], cmp);
    quickSort<T>(slice[i..slice.len], cmp);
}

const std = import("std");

test "sort slice" {
    let init = {3, 1, 5, 4, 2};
    let v = init;
    let v2 = init;
    const sorted = struct {
        pub fn comp(a: i32, b: i32) -> bool {
            return a < b;
        }
    };
    bubbleSort<i32>(v[0..5], &sorted.comp);
    quickSort<i32>(v2[0..5], &sorted.comp);

    let expected = {1, 2, 3, 4, 5};
    std.io.print("init {}\n", init[0..5]);
    std.io.print("v    {}\n", v[0..5]);
    std.io.print("v2   {}\n", v2[0..5]);
    try std.testing.expectEqualSlice<i32>(v[0..5], expected[0..5]);
    try std.testing.expectEqualSlice<i32>(v2[0..5], expected[0..5]);
}