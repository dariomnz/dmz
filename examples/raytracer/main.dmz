const std = import("std");
const vec = import("vec.dmz");
const color = import("color.dmz");
const utils = import("utils.dmz");
const Ray = import("ray.dmz").Ray;
const hittable = import("hittable.dmz");
const sphere = import("sphere.dmz");
const material = import("material.dmz");
const Camera = import("camera.dmz").Camera;

const Vec3 = vec.Vec3;
const Color = color.Color;
const Hittable = hittable.Hittable;
const HitRecord = hittable.HitRecord;
const HittableList = hittable.HittableList;
const Sphere = sphere.Sphere;

let ground = material.Lambertian{albedo: {0.8, 0.8, 0.0}};
let centerMat = material.Lambertian{albedo: {0.1, 0.2, 0.5}};
let left = material.Dielectric{refractionIndex: 1.50};
let bubble = material.Dielectric{refractionIndex: 1.00 / 1.50};
let right = material.Metal{albedo: {0.8, 0.6, 0.2}, fuzz: 1.0};

let blue = material.Lambertian{albedo: {0.0, 0.0, 1.0}};
let red = material.Lambertian{albedo: {1.0, 0.0, 0.0}};

fn makeScene1(alloc: std.mem.Allocator, worldList: *HittableList) -> !void {
    try worldList.add(try Sphere.create(alloc, {0.0, -100.5, -1.0}, 100.0, ground.Material()));
    try worldList.add(try Sphere.create(alloc, {0.0, 0.0, -1.2}, 0.5, centerMat.Material()));
    try worldList.add(try Sphere.create(alloc, {-1.0, 0.0, -1.0}, 0.5, left.Material()));
    try worldList.add(try Sphere.create(alloc, {-1.0, 0.0, -1.0}, 0.4, bubble.Material()));
    try worldList.add(try Sphere.create(alloc, {1.0, 0.0, -1.0}, 0.5, right.Material()));
}

fn makeScene2(alloc: std.mem.Allocator, worldList: *HittableList) -> !void {
    const R = @math(.Cos, std.math.pi / 4.0);
    try worldList.add(try Sphere.create(alloc, {-R, 0.0, -1.0}, R, blue.Material()));
    try worldList.add(try Sphere.create(alloc, {R, 0.0, -1.0}, R, red.Material()));
}

let ground2 = material.Lambertian{albedo: {0.5, 0.5, 0.5}};

fn makeScene3(alloc: std.mem.Allocator, worldList: *HittableList) -> !void {
    // Ground
    try worldList.add(try Sphere.create(alloc, {0, -1000, 0}, 1000.0, ground2.Material()));

    for ((-11)..11) |a| {
        for ((-11)..11) |b| {
            const choose_mat = utils.randf64();
            const center: Vec3 = {@floatCast(a) + 0.9 * utils.randf64(), 0.2, @floatCast(b) + 0.9 * utils.randf64()};

            if (vec.length(center - {4.0, 0.2, 0.0}) > 0.9) {
                if (choose_mat < 0.8) {
                    // diffuse
                    const albedo = vec.rand() * vec.rand();
                    const mat = try alloc.malloc(material.Lambertian, 1);
                    mat[0] = material.Lambertian{albedo: albedo};
                    try worldList.add(try Sphere.create(alloc, center, 0.2, mat[0].Material()));
                } else if (choose_mat < 0.95) {
                    // metal
                    const albedo = vec.randRange(0.5, 1.0);
                    const fuzz = utils.randf64Range(0.0, 0.5);
                    const mat = try alloc.malloc(material.Metal, 1);
                    mat[0] = material.Metal{albedo: albedo, fuzz: fuzz};
                    try worldList.add(try Sphere.create(alloc, center, 0.2, mat[0].Material()));
                } else {
                    // glass
                    const mat = try alloc.malloc(material.Dielectric, 1);
                    mat[0] = material.Dielectric{refractionIndex: 1.5};
                    try worldList.add(try Sphere.create(alloc, center, 0.2, mat[0].Material()));
                }
            }
        }
    }

    {
        const mat = try alloc.malloc(material.Dielectric, 1);
        mat[0] = material.Dielectric{refractionIndex: 1.5};
        try worldList.add(try Sphere.create(alloc, {0, 1, 0}, 1.0, mat[0].Material()));
    }
    {
        const mat = try alloc.malloc(material.Lambertian, 1);
        mat[0] = material.Lambertian{albedo: {0.4, 0.2, 0.1}};
        try worldList.add(try Sphere.create(alloc, {-4, 1, 0}, 1.0, mat[0].Material()));
    }
    {
        const mat = try alloc.malloc(material.Metal, 1);
        mat[0] = material.Metal{albedo: {0.7, 0.6, 0.5}, fuzz: 0.0};
        try worldList.add(try Sphere.create(alloc, {4, 1, 0}, 1.0, mat[0].Material()));
    }
}

fn main() -> void {
    const buffer_size = 1024 * 1024;
    const buffer: [buffer_size]u8;
    let libc_alloc = std.mem.Arena.init(buffer[0..buffer_size]);
    let allocator = libc_alloc.Allocator();

    // World
    const worldList: HittableList = HittableList.init(allocator);
    try makeScene3(allocator, &worldList);
    defer worldList.deinit();

    const world = worldList.Hittable();

    // Render
    let camera = Camera{};
    camera.aspect_ratio = 16.0 / 9.0;
    // camera.image_width = 1200;
    // camera.samples_per_pixel = 500;
    // camera.max_depth = 50;
    camera.image_width       = 1200;
    camera.samples_per_pixel = 10;
    camera.max_depth         = 20;

    camera.vfov = 20.0;

    camera.lookfrom = {13, 2, 3};
    camera.lookat = {0, 0, 0};
    camera.vup = {0, 1, 0};

    camera.render(world);
}