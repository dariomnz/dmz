
const std = import("std");
const vec = import("vec.dmz");

pub const Color = vec.Vec3;

pub fn init(r:f64, g:f64,b:f64) -> Color {
    const rgb = {r,g,b};
    return @simdLoad(&rgb[0]);
}

pub fn fmt(w: std.io.Writer, color: Color) -> void {
    const rgb = color * @simdSplat(255.999);
    const r: u8 = @intCast(rgb[0]);
    const g: u8 = @intCast(rgb[1]);
    const b: u8 = @intCast(rgb[2]);
    std.fmt.fmt(w, "{} {} {}\n", .{r, g, b});
}