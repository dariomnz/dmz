const std = import("std");

pub const Interval = struct {
    min: f64,
    max: f64,

    pub fn size(self: *@This) -> f64 {
        return self.max - self.min;
    }

    pub fn contains(self: *@This, x: f64) -> bool {
        return self.min <= x && x <= self.max;
    }

    pub fn surrounds(self: *@This, x: f64) -> bool {
        return self.min < x && x < self.max;
    }

    pub fn clamp(self: *@This, x: f64) -> f64 {
        if (x < self.min) return self.min;
        if (x > self.max) return self.max;
        return x;
    }

    pub const empty = @This{min: std.math.inf(f64), max: -std.math.inf(f64)};
    pub const universe = @This{min: -std.math.inf(f64), max: std.math.inf(f64)};
};