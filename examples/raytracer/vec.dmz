const std = import("std");
const utils = import("utils.dmz");

pub const Vec3 = @simd(f64, 3);

pub fn x(v: Vec3) -> f64 {
    return v[0];
}
pub fn y(v: Vec3) -> f64 {
    return v[1];
}
pub fn z(v: Vec3) -> f64 {
    return v[2];
}

pub fn length(v: Vec3) -> f64 {
    return @math(.Sqrt, lenghtSquared(v));
}

pub fn lenghtSquared(v: Vec3) -> f64 {
    return @simdReduce(v * v, .Add);
}

pub fn fmt(w: std.io.Writer, v: Vec3) -> void {
    std.fmt.fmt(w, "{} {} {}", .{v[0], v[1], v[2]});
}

pub fn dot(u: Vec3, v: Vec3) -> f64 {
    return @simdReduce(u * v, .Add);
}

pub fn cross(u: Vec3, v: Vec3) -> Vec3 {
    const u_yzx = @simdShuffle(u, @simdSplat(0.0), {1, 2, 0});
    const v_zxy = @simdShuffle(v, @simdSplat(0.0), {2, 0, 1});

    const u_zxy = @simdShuffle(u, @simdSplat(0.0), {2, 0, 1});
    const v_yzx = @simdShuffle(v, @simdSplat(0.0), {1, 2, 0});

    return (u_yzx * v_zxy) - (u_zxy * v_yzx);
}

pub fn unit(v: Vec3) -> Vec3 {
    return v / @simdSplat(length(v));
}

pub fn rand() -> Vec3 {
    return {utils.randf64(), utils.randf64(), utils.randf64()};
}

pub fn randRange(min: f64, max: f64) -> Vec3 {
    return {utils.randf64Range(min, max), utils.randf64Range(min, max), utils.randf64Range(min, max)};
}

pub fn randUnit() -> Vec3 {
    while (true) {
        const p = randRange(-1.0, 1.0);
        const lensq = lenghtSquared(p);
        if (0.00000000001 < lensq && lensq <= 1.0) {
            return p / @simdSplat(@math(.Sqrt, lensq));
        }
    }
}

pub fn randOnHemisphere(normal: Vec3) -> Vec3 {
    const on_unit_sphere = randUnit();
    if (dot(on_unit_sphere, normal) > 0.0) {
        // In the same hemisphere as the normal
        return on_unit_sphere;
    } else {
        return -on_unit_sphere;
    }
}

pub fn reflect(v: Vec3, n: Vec3) -> Vec3 {
    return v - @simdSplat(2.0 * dot(v, n)) * n;
}

pub fn refract(uv: Vec3, n: Vec3, etai_over_etat: f64) -> Vec3 {
    const cos_theta = @math(.Min, dot(-uv, n), 1.0);
    const r_out_perp = @simdSplat(etai_over_etat) * (uv + @simdSplat(cos_theta) * n);
    const r_out_parallel = @simdSplat(-@math(.Sqrt, @math(.Abs, 1.0 - lenghtSquared(r_out_perp)))) * n;
    return r_out_perp + r_out_parallel;
}

pub fn nearZero(vec: Vec3) -> bool {
    // Return true if the vector is close to zero in all dimensions.
    const splat_s: Vec3 = @simdSplat(0.00000001);
    const abs_vec = @math(.Abs, vec);
    const mask = abs_vec < splat_s;
    return @simdReduce(mask, .And);
}