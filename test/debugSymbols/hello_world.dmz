// CHECK-NEXT: !11 = !{!12, !14}
// CHECK-NEXT: !12 = !DIDerivedType(tag: DW_TAG_member, name: "x", scope: !1, file: !1, line: 6, baseType: !13, size: 32, align: 32, flags: DIFlagPublic)
// CHECK-NEXT: !13 = !DIBasicType(name: "i32", size: 32, encoding: DW_ATE_signed)
// CHECK-NEXT: !14 = !DIDerivedType(tag: DW_TAG_member, name: "y", scope: !1, file: !1, line: 7, baseType: !13, size: 32, align: 32, offset: 32, flags: DIFlagPublic)
// CHECK-NEXT: !15 = !DILocation(line: 18, column: 8, scope: !4)
// CHECK-NEXT: !16 = !DILocation(line: 18, column: 7, scope: !4)
// CHECK-NEXT: !17 = !DILocation(line: 16, scope: !4)
// CHECK-NEXT: !18 = distinct !DISubprogram(name: "hello_world.foo", scope: !1, file: !1, line: 10, type: !19, scopeLine: 10, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !21)
// CHECK-NEXT: !19 = !DISubroutineType(types: !20)
// CHECK-NEXT: !20 = !{null, !10, !13, !13, !13}
// CHECK-NEXT: !21 = !{!22, !23, !24, !25}
