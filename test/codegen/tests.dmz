// CHECK-NEXT:   %16 = load i32, ptr %num_test, align 4
// CHECK-NEXT:   %17 = icmp eq i32 %15, %16
// CHECK-NEXT:   br i1 %17, label %if.true44, label %if.false
// CHECK-NEXT: 
// CHECK-NEXT: if.true:                                          ; preds = %for.body
// CHECK-NEXT:   store %slice.struct { ptr @string.literal.5, i64 3 }, ptr %string.literal.slice, align 8
// CHECK-NEXT:   %18 = getelementptr inbounds nuw %"tuple.[]u8", ptr %"tmp.struct.tuple.[]u8", i32 0, i32 0
// CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %18, ptr align 8 @std.terminal.COLORGREEN, i64 16, i1 false)
// CHECK-NEXT:   call void @"std.io.io.print<tuple.[]u8{}>"(ptr sret(%error.struct.usize) %struct.ret.tmp, ptr byval(%slice.struct) %string.literal.slice, ptr readonly %"tmp.struct.tuple.[]u8")
// CHECK-NEXT:   br label %if.exit
// CHECK-NEXT: 
// CHECK-NEXT: if.exit:                                          ; preds = %if.true, %for.body
// CHECK-NEXT:   store %slice.struct { ptr @string.literal.19, i64 9 }, ptr %string.literal.slice3, align 8
