// RUN: dmz %s -I std %S/../../std/std.dmz -llvm-dump -test -module 2>&1 | filecheck %s
// RUN: diff <(dmz %s -I std %S/../../std/std.dmz -run -test -module 2>&1) <(echo -n -e "Run test [1/2] 'add test 2'.\nRun test [2/2] 'add test 3'.\nAll 2 tests passed.\n")
const std = import("std");

fn add(x: i32, y: i32) -> i32 {
    return x + y;
}

test "add test 2" {
    try std.testing.expect(add(1, 1) == 2);
    try std.testing.expect(add(-1, 3) == 2);
}

test "add test 3" {
    try std.testing.expect(add(2, 1) == 3);
    try std.testing.expect(add(2, 2) == 4);
    try std.testing.expect(add(1, add(1, 1)) == 3);
}

// CHECK: define i32 @"std.builtin.@builtin_test_num"() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %retval = alloca i32, align 4
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %retval, i8 0, i64 4, i1 false)
// CHECK-NEXT:   store i32 2, ptr %retval, align 4
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %entry
// CHECK-NEXT:   %0 = load i32, ptr %retval, align 4
// CHECK-NEXT:   ret i32 %0
// CHECK-NEXT: }
// CHECK-NEXT: 

// CHECK: define void @"std.builtin.@builtin_test_run"(ptr sret(%error.struct.void) %ret, i32 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %n = alloca i32, align 4
// CHECK-NEXT:   %struct.ret.tmp = alloca %error.struct.void, align 8
// CHECK-NEXT:   %struct.ret.tmp2 = alloca %error.struct.void, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %n, i8 0, i64 4, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %struct.ret.tmp, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %struct.ret.tmp2, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 16, i1 false)
// CHECK-NEXT:   store i32 %0, ptr %n, align 4
// CHECK-NEXT:   %1 = load i32, ptr %n, align 4
// CHECK-NEXT:   switch i32 %1, label %switch.else [
// CHECK-NEXT:     i32 0, label %switch.case
// CHECK-NEXT:     i32 1, label %switch.case1
// CHECK-NEXT:   ]
// CHECK-NEXT: 
// CHECK-NEXT: switch.case:                                      ; preds = %entry
// CHECK-NEXT:   call void @"add test 2"(ptr sret(%error.struct.void) %struct.ret.tmp)
// CHECK-NEXT:   %2 = getelementptr inbounds nuw %error.struct.void, ptr %struct.ret.tmp, i32 0, i32 1
// CHECK-NEXT:   %3 = load ptr, ptr %2, align 8
// CHECK-NEXT:   %errorTraceGlobal.idx = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %4 = ptrtoint ptr %3 to i64
// CHECK-NEXT:   %ptr.to.bool = icmp ne i64 %4, 0
// CHECK-NEXT:   br i1 %ptr.to.bool, label %if.true.try, label %if.exit.try
// CHECK-NEXT: 
// CHECK-NEXT: if.true.try:                                      ; preds = %switch.case
// CHECK-NEXT:   %5 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %6 = icmp slt i32 %5, 20
// CHECK-NEXT:   br i1 %6, label %error_trace.push, label %error_trace.merge
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.push:                                 ; preds = %if.true.try
// CHECK-NEXT:   %7 = getelementptr [20 x %ErrorTraceEntry], ptr getelementptr inbounds nuw (%ErrorTrace, ptr @dmz_error_trace, i32 0, i32 1), i32 0, i32 %5
// CHECK-NEXT:   store %ErrorTraceEntry { %slice.struct { ptr @global.str.trace.data.3, i64 7 }, i32 0, i32 1, %slice.struct { ptr @global.str.trace.data.4, i64 29 } }, ptr %7, align 8
// CHECK-NEXT:   %8 = add i32 %5, 1
// CHECK-NEXT:   store i32 %8, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %error_trace.merge
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.merge:                                ; preds = %error_trace.push, %if.true.try
// CHECK-NEXT:   %9 = getelementptr inbounds nuw %error.struct.void, ptr %ret, i32 0, i32 1
// CHECK-NEXT:   store ptr %3, ptr %9, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit.try:                                      ; preds = %switch.case
// CHECK-NEXT:   store i32 %errorTraceGlobal.idx, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %switch.exit
// CHECK-NEXT: 
// CHECK-NEXT: switch.case1:                                     ; preds = %entry
// CHECK-NEXT:   call void @"add test 3"(ptr sret(%error.struct.void) %struct.ret.tmp2)
// CHECK-NEXT:   %10 = getelementptr inbounds nuw %error.struct.void, ptr %struct.ret.tmp2, i32 0, i32 1
// CHECK-NEXT:   %11 = load ptr, ptr %10, align 8
// CHECK-NEXT:   %errorTraceGlobal.idx3 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %12 = ptrtoint ptr %11 to i64
// CHECK-NEXT:   %ptr.to.bool4 = icmp ne i64 %12, 0
// CHECK-NEXT:   br i1 %ptr.to.bool4, label %if.true.try5, label %if.exit.try8
// CHECK-NEXT: 
// CHECK-NEXT: if.true.try5:                                     ; preds = %switch.case1
// CHECK-NEXT:   %13 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %14 = icmp slt i32 %13, 20
// CHECK-NEXT:   br i1 %14, label %error_trace.push6, label %error_trace.merge7
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.push6:                                ; preds = %if.true.try5
// CHECK-NEXT:   %15 = getelementptr [20 x %ErrorTraceEntry], ptr getelementptr inbounds nuw (%ErrorTrace, ptr @dmz_error_trace, i32 0, i32 1), i32 0, i32 %13
// CHECK-NEXT:   store %ErrorTraceEntry { %slice.struct { ptr @global.str.trace.data.3, i64 7 }, i32 0, i32 1, %slice.struct { ptr @global.str.trace.data.4, i64 29 } }, ptr %15, align 8
// CHECK-NEXT:   %16 = add i32 %13, 1
// CHECK-NEXT:   store i32 %16, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %error_trace.merge7
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.merge7:                               ; preds = %error_trace.push6, %if.true.try5
// CHECK-NEXT:   %17 = getelementptr inbounds nuw %error.struct.void, ptr %ret, i32 0, i32 1
// CHECK-NEXT:   store ptr %11, ptr %17, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit.try8:                                     ; preds = %switch.case1
// CHECK-NEXT:   store i32 %errorTraceGlobal.idx3, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %switch.exit
// CHECK-NEXT: 
// CHECK-NEXT: switch.else:                                      ; preds = %entry
// CHECK-NEXT:   br label %switch.exit
// CHECK-NEXT: 
// CHECK-NEXT: switch.exit:                                      ; preds = %switch.else, %if.exit.try8, %if.exit.try
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %switch.exit, %error_trace.merge7, %error_trace.merge
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

// CHECK: define ptr @"std.builtin.@builtin_test_name"(i32 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %retval = alloca ptr, align 8
// CHECK-NEXT:   %n = alloca i32, align 4
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %retval, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %n, i8 0, i64 4, i1 false)
// CHECK-NEXT:   store i32 %0, ptr %n, align 4
// CHECK-NEXT:   %1 = load i32, ptr %n, align 4
// CHECK-NEXT:   switch i32 %1, label %switch.else [
// CHECK-NEXT:     i32 0, label %switch.case
// CHECK-NEXT:     i32 1, label %switch.case1
// CHECK-NEXT:   ]
// CHECK-NEXT: 
// CHECK-NEXT: switch.case:                                      ; preds = %entry
// CHECK-NEXT:   store ptr @global.str.trace.data.1, ptr %retval, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: switch.case1:                                     ; preds = %entry
// CHECK-NEXT:   store ptr @global.str.trace.data.2, ptr %retval, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: switch.else:                                      ; preds = %entry
// CHECK-NEXT:   store ptr @string.literal, ptr %retval, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: switch.exit:                                      ; No predecessors!
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %switch.exit, %switch.else, %switch.case1, %switch.case
// CHECK-NEXT:   %2 = load ptr, ptr %retval, align 8
// CHECK-NEXT:   ret ptr %2
// CHECK-NEXT: }

