// RUN: dmz %s -I std %S/../../std/std.dmz -llvm-dump -test -module 2>&1 | filecheck %s
// RUN: diff <(dmz %s -I std %S/../../std/std.dmz -run -test -module 2>&1) <(echo -n -e "Run test [1/2] 'add test 2'.\nRun test [2/2] 'add test 3'.\nAll 2 tests passed.\n")
const std = import("std");

fn add(x: i32, y: i32) -> i32 {
    return x + y;
}

test "add test 2" {
    try std.testing.expect(add(1, 1) == 2);
    try std.testing.expect(add(-1, 3) == 2);
}

test "add test 3" {
    try std.testing.expect(add(2, 1) == 3);
    try std.testing.expect(add(2, 2) == 4);
    try std.testing.expect(add(1, add(1, 1)) == 3);
}

// CHECK: define void @std.builtin.runTest(ptr sret(%error.struct.void) %ret, i64 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %n = alloca i64, align 8
// CHECK-NEXT:   %i = alloca i64, align 8
// CHECK-NEXT:   %struct.ret.tmp = alloca %error.struct.void, align 8
// CHECK-NEXT:   %i1 = alloca i64, align 8
// CHECK-NEXT:   %struct.ret.tmp3 = alloca %error.struct.void, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %n, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %i, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %struct.ret.tmp, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %i1, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %struct.ret.tmp3, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 16, i1 false)
// CHECK-NEXT:   store i64 %0, ptr %n, align 4
// CHECK-NEXT:   store i64 0, ptr %i, align 4
// CHECK-NEXT:   %1 = load i64, ptr %n, align 4
// CHECK-NEXT:   %2 = icmp eq i64 0, %1
// CHECK-NEXT:   br i1 %2, label %if.true, label %if.exit
// CHECK-NEXT: 
// CHECK-NEXT: if.true:                                          ; preds = %entry
// CHECK-NEXT:   call void @"add test 2"(ptr sret(%error.struct.void) %struct.ret.tmp)
// CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %struct.ret.tmp, i64 16, i1 false)
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit:                                          ; preds = %entry
// CHECK-NEXT:   store i64 1, ptr %i1, align 4
// CHECK-NEXT:   %3 = load i64, ptr %n, align 4
// CHECK-NEXT:   %4 = icmp eq i64 1, %3
// CHECK-NEXT:   br i1 %4, label %if.true2, label %if.exit4
// CHECK-NEXT: 
// CHECK-NEXT: if.true2:                                         ; preds = %if.exit
// CHECK-NEXT:   call void @"add test 3"(ptr sret(%error.struct.void) %struct.ret.tmp3)
// CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %struct.ret.tmp3, i64 16, i1 false)
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit4:                                         ; preds = %if.exit
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %if.exit4, %if.true2, %if.true
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

// CHECK: define void @std.builtin.getTestName(ptr sret(%slice.struct) %ret, i64 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %n = alloca i64, align 8
// CHECK-NEXT:   %i = alloca i64, align 8
// CHECK-NEXT:   %test.name.slice.0 = alloca %slice.struct, align 8
// CHECK-NEXT:   %i1 = alloca i64, align 8
// CHECK-NEXT:   %test.name.slice.1 = alloca %slice.struct, align 8
// CHECK-NEXT:   %string.literal.slice = alloca %slice.struct, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %n, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %i, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %test.name.slice.0, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %i1, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %test.name.slice.1, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %string.literal.slice, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 16, i1 false)
// CHECK-NEXT:   store i64 %0, ptr %n, align 4
// CHECK-NEXT:   store i64 0, ptr %i, align 4
// CHECK-NEXT:   %1 = load i64, ptr %n, align 4
// CHECK-NEXT:   %2 = icmp eq i64 0, %1
// CHECK-NEXT:   br i1 %2, label %if.true, label %if.exit
// CHECK-NEXT: 
// CHECK-NEXT: if.true:                                          ; preds = %entry
// CHECK-NEXT:   store %slice.struct { ptr @global.str.trace.function.FF100A5A, i64 10 }, ptr %test.name.slice.0, align 8
// CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %test.name.slice.0, i64 16, i1 false)
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit:                                          ; preds = %entry
// CHECK-NEXT:   store i64 1, ptr %i1, align 4
// CHECK-NEXT:   %3 = load i64, ptr %n, align 4
// CHECK-NEXT:   %4 = icmp eq i64 1, %3
// CHECK-NEXT:   br i1 %4, label %if.true2, label %if.exit3
// CHECK-NEXT: 
// CHECK-NEXT: if.true2:                                         ; preds = %if.exit
// CHECK-NEXT:   store %slice.struct { ptr @global.str.trace.function.829DF4DF, i64 10 }, ptr %test.name.slice.1, align 8
// CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %test.name.slice.1, i64 16, i1 false)
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit3:                                         ; preds = %if.exit
// CHECK-NEXT:   store %slice.struct { ptr @string.literal.1E462A6E, i64 0 }, ptr %string.literal.slice, align 8
// CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %string.literal.slice, i64 16, i1 false)
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %if.exit3, %if.true2, %if.true
// CHECK-NEXT:   ret void
// CHECK-NEXT: }
// CHECK-NEXT: 

