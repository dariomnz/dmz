// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: dmz %s -run | grep -Plzxe '-234\n456\n-12\n'
fn negate(negate_arg: i32) -> i32 {
    return -negate_arg;
    
    // CHECK: %1 = load i32, ptr %negate_arg, align 4
    // CHECK-NEXT: %2 = sub i32 0, %1
}

fn negate2(negate2_arg: i32) -> i32 {
    return - -negate2_arg;

    // CHECK: %1 = load i32, ptr %negate2_arg, align 4
    // CHECK-NEXT: %2 = sub i32 0, %1
    // CHECK-NEXT: %3 = sub i32 0, %2
}

fn timesNeg3(timesNeg3_arg: i32) -> i32 {
    return -(timesNeg3_arg - -timesNeg3_arg -(-timesNeg3_arg));  

    // CHECK: %1 = load i32, ptr %timesNeg3_arg, align 4
    // CHECK-NEXT: %2 = load i32, ptr %timesNeg3_arg, align 4
    // CHECK-NEXT: %3 = sub i32 0, %2
    // CHECK-NEXT: %4 = sub i32 %1, %3
    // CHECK-NEXT: %5 = load i32, ptr %timesNeg3_arg, align 4
    // CHECK-NEXT: %6 = sub i32 0, %5
    // CHECK-NEXT: %7 = sub i32 %4, %6
    // CHECK-NEXT: %8 = sub i32 0, %7
}
extern fn printf(fmt:*u8, ...) -> i32; fn println(n:i32) -> void {printf("%d\n", n);}

fn main() -> void {
    println(negate(234));
    println(negate2(456));
    println(timesNeg3(4));
}
