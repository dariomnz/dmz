// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s

extern fn printf(fmt: *u8, ...) -> void;

fn main() -> void {
    let arr: [4]i32 = {1, 2, 3, 4};
    let v: @simd<i32, 4> = @simdLoad(&arr[0]);

    let out: [4]i32 = {0, 0, 0, 0};
    @simdStore(v, &out[0]);

    printf("v = %d %d %d %d\n", v[0], v[1], v[2], v[3]);
    printf("out = %d %d %d %d\n", out[0], out[1], out[2], out[3]);
}
// CHECK: define void @__builtin_main() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %arr = alloca [4 x i32], align 4
// CHECK-NEXT:   %"array.[4]i32.tmp" = alloca [4 x i32], align 4
// CHECK-NEXT:   %v = alloca <4 x i32>, align 16
// CHECK-NEXT:   %out = alloca [4 x i32], align 4
// CHECK-NEXT:   %"array.[4]i32.tmp1" = alloca [4 x i32], align 4
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %arr, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %"array.[4]i32.tmp", i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %v, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %out, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %"array.[4]i32.tmp1", i8 0, i64 16, i1 false)
// CHECK-NEXT:   store [4 x i32] [i32 1, i32 2, i32 3, i32 4], ptr %"array.[4]i32.tmp", align 4
// CHECK-NEXT:   call void @llvm.memcpy.inline.p0.p0.i64(ptr align 4 %arr, ptr align 4 %"array.[4]i32.tmp", i64 16, i1 false)
// CHECK-NEXT:   %0 = getelementptr [4 x i32], ptr %arr, i32 0, i32 0
// CHECK-NEXT:   %simd.load = load <4 x i32>, ptr %0, align 1
// CHECK-NEXT:   store <4 x i32> %simd.load, ptr %v, align 16
// CHECK-NEXT:   store [4 x i32] zeroinitializer, ptr %"array.[4]i32.tmp1", align 4
// CHECK-NEXT:   call void @llvm.memcpy.inline.p0.p0.i64(ptr align 4 %out, ptr align 4 %"array.[4]i32.tmp1", i64 16, i1 false)
// CHECK-NEXT:   %1 = getelementptr [4 x i32], ptr %out, i32 0, i32 0
// CHECK-NEXT:   %2 = load <4 x i32>, ptr %v, align 16
// CHECK-NEXT:   store <4 x i32> %2, ptr %1, align 1
// CHECK-NEXT:   %3 = load <4 x i32>, ptr %v, align 16
// CHECK-NEXT:   %4 = extractelement <4 x i32> %3, i32 0
// CHECK-NEXT:   %5 = load <4 x i32>, ptr %v, align 16
// CHECK-NEXT:   %6 = extractelement <4 x i32> %5, i32 1
// CHECK-NEXT:   %7 = load <4 x i32>, ptr %v, align 16
// CHECK-NEXT:   %8 = extractelement <4 x i32> %7, i32 2
// CHECK-NEXT:   %9 = load <4 x i32>, ptr %v, align 16
// CHECK-NEXT:   %10 = extractelement <4 x i32> %9, i32 3
// CHECK-NEXT:   call void (ptr, ...) @printf(ptr byref(i8) @string.literal.AA9C101C, i32 %4, i32 %6, i32 %8, i32 %10)
// CHECK-NEXT:   %11 = getelementptr [4 x i32], ptr %out, i32 0, i32 0
// CHECK-NEXT:   %12 = load i32, ptr %11, align 4
// CHECK-NEXT:   %13 = getelementptr [4 x i32], ptr %out, i32 0, i32 1
// CHECK-NEXT:   %14 = load i32, ptr %13, align 4
// CHECK-NEXT:   %15 = getelementptr [4 x i32], ptr %out, i32 0, i32 2
// CHECK-NEXT:   %16 = load i32, ptr %15, align 4
// CHECK-NEXT:   %17 = getelementptr [4 x i32], ptr %out, i32 0, i32 3
// CHECK-NEXT:   %18 = load i32, ptr %17, align 4
// CHECK-NEXT:   call void (ptr, ...) @printf(ptr byref(i8) @string.literal.DF77EEBC, i32 %12, i32 %14, i32 %16, i32 %18)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }