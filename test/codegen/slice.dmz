// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: diff <(dmz %s -run 2>&1) <(echo -n -e "Slice len 5: 'Hello'\nSlice2 len 1: 'H'\n")

extern fn printf(fmt: *u8, ...) -> i32;
fn main() -> void {
    const str = "Hello, World\n";
    const slice: []u8 = str[0..5];

    printf("Slice len %d: '%.*s'\n", slice.len, slice.len, slice.ptr);

    const slice2: []u8 = str[0..1];

    printf("Slice2 len %d: '%.*s'\n", slice2.len, slice2.len, slice2.ptr);
}
// CHECK: define void @__builtin_main() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %str = alloca ptr, align 8
// CHECK-NEXT:   %slice = alloca %slice.struct, align 8
// CHECK-NEXT:   %string.literal.slice = alloca %slice.struct, align 8
// CHECK-NEXT:   %slice2 = alloca %slice.struct, align 8
// CHECK-NEXT:   %string.literal.slice1 = alloca %slice.struct, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %str, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %slice, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %string.literal.slice, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %slice2, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %string.literal.slice1, i8 0, i64 16, i1 false)
// CHECK-NEXT:   store ptr @string.literal.E524BB7F, ptr %str, align 8
// CHECK-NEXT:   store %slice.struct { ptr @string.literal.FC631EB5, i64 5 }, ptr %string.literal.slice, align 8
// CHECK-NEXT:   call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %slice, ptr align 8 %string.literal.slice, i64 16, i1 false)
// CHECK-NEXT:   %0 = call i32 (ptr, ...) @printf(ptr byref(i8) @string.literal.48DBEC99, i64 5, i64 5, ptr @string.literal.FC631EB5)
// CHECK-NEXT:   store %slice.struct { ptr @string.literal.E05D347B, i64 1 }, ptr %string.literal.slice1, align 8
// CHECK-NEXT:   call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %slice2, ptr align 8 %string.literal.slice1, i64 16, i1 false)
// CHECK-NEXT:   %1 = call i32 (ptr, ...) @printf(ptr byref(i8) @string.literal.CD3E4215, i64 1, i64 1, ptr @string.literal.E05D347B)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }