// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: diff <(dmz %s -run 2>&1) <(echo -n -e '30\n300\n80\n')

extern fn printf(fmt: *u8, ...) -> i32;
fn println(n: i32) -> void { printf("%d\n", n); }

fn add(comptime a: i32, b: i32) -> i32 {
    return a + b;
}
// CHECK: define i32 @"comptime_params_mixed.add<comptime(10)>"(i32 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %retval = alloca i32, align 4
// CHECK-NEXT:   %b = alloca i32, align 4
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %retval, i8 0, i64 4, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %b, i8 0, i64 4, i1 false)
// CHECK-NEXT:   store i32 %0, ptr %b, align 4
// CHECK-NEXT:   %1 = load i32, ptr %b, align 4
// CHECK-NEXT:   %2 = add i32 10, %1
// CHECK-NEXT:   store i32 %2, ptr %retval, align 4
// CHECK-NEXT:   br label %return
// CHECK-NEXT:
// CHECK-NEXT: return:                                           ; preds = %entry
// CHECK-NEXT:   %3 = load i32, ptr %retval, align 4
// CHECK-NEXT:   ret i32 %3
// CHECK-NEXT: }

fn add_three(comptime x: i32, comptime y: i32, z: i32) -> i32 {
    return x + y + z;
}
// CHECK: define i32 @"comptime_params_mixed.add_three<comptime(10), comptime(20)>"(i32 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %retval = alloca i32, align 4
// CHECK-NEXT:   %z = alloca i32, align 4
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %retval, i8 0, i64 4, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %z, i8 0, i64 4, i1 false)
// CHECK-NEXT:   store i32 %0, ptr %z, align 4
// CHECK-NEXT:   %1 = load i32, ptr %z, align 4
// CHECK-NEXT:   %2 = add i32 30, %1
// CHECK-NEXT:   store i32 %2, ptr %retval, align 4
// CHECK-NEXT:   br label %return
// CHECK-NEXT:
// CHECK-NEXT: return:                                           ; preds = %entry
// CHECK-NEXT:   %3 = load i32, ptr %retval, align 4
// CHECK-NEXT:   ret i32 %3
// CHECK-NEXT: }

fn main() -> void {
    const x = add(10, 20);
    println(x);
    const y = add(100, 200);
    println(y);
    const z = add_three(10, 20, 50);
    println(z);
}
