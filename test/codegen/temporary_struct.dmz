// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: diff <(dmz %s -run 2>&1) <(echo -n -e '3\n3\n1\n2\n3\n')
const S = struct {
    x: i32,
    s2: S2,
};

const S2 = struct {
    x: i32,
    y: i32,
    z: i32,
};

extern fn printf(fmt: *u8, ...) -> i32;
fn println(n: i32) -> void {
    printf("%d\n", n);
}

fn foo() -> void {
    println(S2{x: 1, y: 2, z: 3}.z);
    println(S{x: 1, s2: S2{x: 2, y: 3, z: 4}}.s2.y);
}
// CHECK: define void @temporary_struct.foo() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @temporary_struct.println(i32 3)
// CHECK-NEXT:   call void @temporary_struct.println(i32 3)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

// CHECK: define void @temporary_struct.bar() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @temporary_struct.println(i32 1)
// CHECK-NEXT:   call void @temporary_struct.println(i32 2)
// CHECK-NEXT:   call void @temporary_struct.println(i32 3)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

fn bar() -> void {
    println(S2{x: 1, y: 2, z: 3}.x);
    println(S2{x: 1, y: 2, z: 3}.y);
    println(S2{x: 1, y: 2, z: 3}.z);
}
// CHECK: define void @temporary_struct.bar() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @temporary_struct.println(i32 1)
// CHECK-NEXT:   call void @temporary_struct.println(i32 2)
// CHECK-NEXT:   call void @temporary_struct.println(i32 3)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

fn main() -> void {
    foo();
    bar();
}