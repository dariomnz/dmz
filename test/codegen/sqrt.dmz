// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s

extern fn printf(fmt: *u8, ...) -> i32;
fn main() -> void {
    const val1 = @sqrt(4.0);
    const val2 = @sqrt(2.0);
    const val3 = @sqrt(1.0);
    const val4 = @sqrt(20.0);

    const simd1: @simd<f32, 4> = @simdIota();
    const simd2: @simd<f64, 4> = @simdSplat(5.0);

    const val5 = @sqrt(simd1);
    const val6 = @sqrt(simd2);
}
// CHECK: %sqrt = call double @llvm.sqrt.f64(double 4.000000e+00)
// CHECK-NEXT: store double %sqrt, ptr %val1, align 8
// CHECK-NEXT: %sqrt1 = call double @llvm.sqrt.f64(double 2.000000e+00)
// CHECK-NEXT: store double %sqrt1, ptr %val2, align 8
// CHECK-NEXT: %sqrt2 = call double @llvm.sqrt.f64(double 1.000000e+00)
// CHECK-NEXT: store double %sqrt2, ptr %val3, align 8
// CHECK-NEXT: %sqrt3 = call double @llvm.sqrt.f64(double 2.000000e+01)
// CHECK-NEXT: store double %sqrt3, ptr %val4, align 8
// CHECK-NEXT: store <4 x float> <float 0.000000e+00, float 1.000000e+00, float 2.000000e+00, float 3.000000e+00>, ptr %simd1, align 16
// CHECK-NEXT: store <4 x double> splat (double 5.000000e+00), ptr %simd2, align 32
// CHECK-NEXT: %0 = load <4 x float>, ptr %simd1, align 16
// CHECK-NEXT: %sqrt4 = call <4 x float> @llvm.sqrt.v4f32(<4 x float> %0)
// CHECK-NEXT: store <4 x float> %sqrt4, ptr %val5, align 16
// CHECK-NEXT: %1 = load <4 x double>, ptr %simd2, align 32
// CHECK-NEXT: %sqrt5 = call <4 x double> @llvm.sqrt.v4f64(<4 x double> %1)
// CHECK-NEXT: store <4 x double> %sqrt5, ptr %val6, align 32