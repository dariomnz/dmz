// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s

extern fn printf(fmt: *u8, ...) -> i32;
fn main() -> void {
    let val1 = 4.0;
    const sqrtval1 = @math(.Sqrt, val1);
    let val2 = 2.0;
    const sqrtval2 = @math(.Sqrt, val2);
    let val3 = 1.0;
    const sqrtval3 = @math(.Sqrt, val3);
    let val4 = 20.0;
    const sqrtval4 = @math(.Sqrt, val4);

    let simd1: @simd(f32, 4) = @simdIota();
    let simd2: @simd(f64, 4) = @simdSplat(5.0);

    const val5 = @math(.Sqrt, simd1);
    const val6 = @math(.Sqrt, simd2);
}
// CHECK:   %0 = load double, ptr %val1, align 8
// CHECK-NEXT:   %sqrt = call double @llvm.sqrt.f64(double %0)
// CHECK-NEXT:   store double %sqrt, ptr %sqrtval1, align 8
// CHECK-NEXT:   store double 2.000000e+00, ptr %val2, align 8
// CHECK-NEXT:   %1 = load double, ptr %val2, align 8
// CHECK-NEXT:   %sqrt1 = call double @llvm.sqrt.f64(double %1)
// CHECK-NEXT:   store double %sqrt1, ptr %sqrtval2, align 8
// CHECK-NEXT:   store double 1.000000e+00, ptr %val3, align 8
// CHECK-NEXT:   %2 = load double, ptr %val3, align 8
// CHECK-NEXT:   %sqrt2 = call double @llvm.sqrt.f64(double %2)
// CHECK-NEXT:   store double %sqrt2, ptr %sqrtval3, align 8
// CHECK-NEXT:   store double 2.000000e+01, ptr %val4, align 8
// CHECK-NEXT:   %3 = load double, ptr %val4, align 8
// CHECK-NEXT:   %sqrt3 = call double @llvm.sqrt.f64(double %3)
// CHECK-NEXT:   store double %sqrt3, ptr %sqrtval4, align 8
// CHECK-NEXT:   store <4 x float> <float 0.000000e+00, float 1.000000e+00, float 2.000000e+00, float 3.000000e+00>, ptr %simd1, align 16
// CHECK-NEXT:   store <4 x double> splat (double 5.000000e+00), ptr %simd2, align 32
// CHECK-NEXT:   %4 = load <4 x float>, ptr %simd1, align 16
// CHECK-NEXT:   %sqrt4 = call <4 x float> @llvm.sqrt.v4f32(<4 x float> %4)
// CHECK-NEXT:   store <4 x float> %sqrt4, ptr %val5, align 16
// CHECK-NEXT:   %5 = load <4 x double>, ptr %simd2, align 32
// CHECK-NEXT:   %sqrt5 = call <4 x double> @llvm.sqrt.v4f64(<4 x double> %5)
// CHECK-NEXT:   store <4 x double> %sqrt5, ptr %val6, align 32