// RUN: dmz %s -run 2>&1 | filecheck %s
extern fn printf(fmt: *u8, ...) -> i32;

fn printVector<T>(v: T, len: i32, fmt: *u8) -> void {
    printf("[ ");
    for (0..len) |i| {
        printf(fmt, v[i]);
    }
    printf("]\n");
}

pub fn main() -> void {
    const size = 4;

    const a_data: [size]f64 = {10.5, 2.0, 30.1, 4.4};
    const a: @simd<f64, size> = @simd<f64, size>.load(&a_data[0]);
    const b_data: [size]f64 = {5.0, 8.8, 15.0, 20.2};
    const b: @simd<f64, size> = @simd<f64, size>.load(&b_data[0]);

    const mask: @simd<bool, size> = a > b;

    const result = a.select(b, mask);

    printf("Vector A: ");
    printVector<a>(a, size, "%f ");
    printf("Vector B: ");
    printVector<b>(b, size, "%f ");
    printf("Mask (A>B): ");
    printVector<mask>(mask, size, "%d ");
    printf("Result: ");
    printVector<result>(result, size, "%f ");
}
// CHECK: Vector A: [ 10.500000 2.000000 30.100000 4.400000 ]
// CHECK-NEXT: Vector B: [ 5.000000 8.800000 15.000000 20.200000 ]
// CHECK-NEXT: Mask (A>B): [ 1 0 1 0 ]
// CHECK-NEXT: Result: [ 10.500000 8.800000 30.100000 20.200000 ]