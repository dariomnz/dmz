// CHECK-NEXT:   br i1 %ptr.to.bool22, label %if.true.try23, label %if.exit.try26
// CHECK-NEXT: 
// CHECK-NEXT: if.true.try23:                                    ; preds = %catch.exit18
// CHECK-NEXT:   %62 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %63 = icmp slt i32 %62, 20
// CHECK-NEXT:   br i1 %63, label %error_trace.push24, label %error_trace.merge25
