// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: diff <(dmz %s -run 2>&1) <(echo -n -e "10\nERROR_TWO\nThere was no error\n10\nThere are an error\nNo error 10\nNo safe error 10\n")

const e = error {
    ERROR_ONE,
    ERROR_TWO,
    ERROR_THREE,
};
// CHECK: @error.str.SUCCESS = private constant [8 x i8] c"SUCCESS\00"
// CHECK-NEXT: @error.str.ERROR_ONE = private constant [10 x i8] c"ERROR_ONE\00"
// CHECK-NEXT: @error.str.ERROR_TWO = private constant [10 x i8] c"ERROR_TWO\00"
// CHECK-NEXT: @error.str.ERROR_THREE = private constant [12 x i8] c"ERROR_THREE\00"

fn foo(x: i32) -> !i32 {
    if (x == 1) {
        return e.ERROR_ONE;
    }
    return x;
}
// CHECK: define void @error_handle.foo(ptr sret(%error.struct.i32) %ret, i32 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %x = alloca i32, align 4
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %x, i8 0, i64 4, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 16, i1 false)
// CHECK-NEXT:   store i32 %0, ptr %x, align 4
// CHECK-NEXT:   %1 = load i32, ptr %x, align 4
// CHECK-NEXT:   %2 = icmp eq i32 %1, 1
// CHECK-NEXT:   br i1 %2, label %if.true, label %if.exit
// CHECK-NEXT: 
// CHECK-NEXT: if.true:                                          ; preds = %entry
// CHECK-NEXT:   %3 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %4 = icmp slt i32 %3, 20
// CHECK-NEXT:   br i1 %4, label %error_trace.push, label %error_trace.merge
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.push:                                 ; preds = %if.true
// CHECK-NEXT:   %5 = getelementptr [20 x %ErrorTraceEntry], ptr getelementptr inbounds nuw (%ErrorTrace, ptr @dmz_error_trace, i32 0, i32 1), i32 0, i32 %3
// CHECK-NEXT:   store %ErrorTraceEntry { %slice.struct { ptr @global.str.trace.data, i64 49 }, i32 16, i32 9, %slice.struct { ptr @global.str.trace.data.1, i64 16 } }, ptr %5, align 8
// CHECK-NEXT:   %6 = add i32 %3, 1
// CHECK-NEXT:   store i32 %6, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %error_trace.merge
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.merge:                                ; preds = %error_trace.push, %if.true
// CHECK-NEXT:   %7 = getelementptr inbounds nuw %error.struct.i32, ptr %ret, i32 0, i32 1
// CHECK-NEXT:   store ptr @error.str.ERROR_ONE, ptr %7, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit:                                          ; preds = %entry
// CHECK-NEXT:   %8 = load i32, ptr %x, align 4
// CHECK-NEXT:   store i32 %8, ptr %ret, align 4
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %if.exit, %error_trace.merge
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

fn bar(x: i32) -> !i32 {
    if (x == 2) {
        return e.ERROR_TWO;
    }
    return try foo(x);
}
// CHECK: define void @error_handle.bar(ptr sret(%error.struct.i32) %ret, i32 %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %x = alloca i32, align 4
// CHECK-NEXT:   %struct.ret.tmp = alloca %error.struct.i32, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %x, i8 0, i64 4, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %struct.ret.tmp, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 16, i1 false)
// CHECK-NEXT:   store i32 %0, ptr %x, align 4
// CHECK-NEXT:   %1 = load i32, ptr %x, align 4
// CHECK-NEXT:   %2 = icmp eq i32 %1, 2
// CHECK-NEXT:   br i1 %2, label %if.true, label %if.exit
// CHECK-NEXT: 
// CHECK-NEXT: if.true:                                          ; preds = %entry
// CHECK-NEXT:   %3 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %4 = icmp slt i32 %3, 20
// CHECK-NEXT:   br i1 %4, label %error_trace.push, label %error_trace.merge
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.push:                                 ; preds = %if.true
// CHECK-NEXT:   %5 = getelementptr [20 x %ErrorTraceEntry], ptr getelementptr inbounds nuw (%ErrorTrace, ptr @dmz_error_trace, i32 0, i32 1), i32 0, i32 %3
// CHECK-NEXT:   store %ErrorTraceEntry { %slice.struct { ptr @global.str.trace.data, i64 49 }, i32 58, i32 9, %slice.struct { ptr @global.str.trace.data.2, i64 16 } }, ptr %5, align 8
// CHECK-NEXT:   %6 = add i32 %3, 1
// CHECK-NEXT:   store i32 %6, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %error_trace.merge
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.merge:                                ; preds = %error_trace.push, %if.true
// CHECK-NEXT:   %7 = getelementptr inbounds nuw %error.struct.i32, ptr %ret, i32 0, i32 1
// CHECK-NEXT:   store ptr @error.str.ERROR_TWO, ptr %7, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit:                                          ; preds = %entry
// CHECK-NEXT:   %8 = load i32, ptr %x, align 4
// CHECK-NEXT:   call void @error_handle.foo(ptr sret(%error.struct.i32) %struct.ret.tmp, i32 %8)
// CHECK-NEXT:   %9 = getelementptr inbounds nuw %error.struct.i32, ptr %struct.ret.tmp, i32 0, i32 1
// CHECK-NEXT:   %10 = load ptr, ptr %9, align 8
// CHECK-NEXT:   %errorTraceGlobal.idx = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %11 = ptrtoint ptr %10 to i64
// CHECK-NEXT:   %ptr.to.bool = icmp ne i64 %11, 0
// CHECK-NEXT:   br i1 %ptr.to.bool, label %if.true.try, label %if.exit.try
// CHECK-NEXT: 
// CHECK-NEXT: if.true.try:                                      ; preds = %if.exit
// CHECK-NEXT:   %12 = load i32, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %13 = icmp slt i32 %12, 20
// CHECK-NEXT:   br i1 %13, label %error_trace.push1, label %error_trace.merge2
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.push1:                                ; preds = %if.true.try
// CHECK-NEXT:   %14 = getelementptr [20 x %ErrorTraceEntry], ptr getelementptr inbounds nuw (%ErrorTrace, ptr @dmz_error_trace, i32 0, i32 1), i32 0, i32 %12
// CHECK-NEXT:   store %ErrorTraceEntry { %slice.struct { ptr @global.str.trace.data, i64 49 }, i32 60, i32 12, %slice.struct { ptr @global.str.trace.data.2, i64 16 } }, ptr %14, align 8
// CHECK-NEXT:   %15 = add i32 %12, 1
// CHECK-NEXT:   store i32 %15, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   br label %error_trace.merge2
// CHECK-NEXT: 
// CHECK-NEXT: error_trace.merge2:                               ; preds = %error_trace.push1, %if.true.try
// CHECK-NEXT:   %16 = getelementptr inbounds nuw %error.struct.i32, ptr %ret, i32 0, i32 1
// CHECK-NEXT:   store ptr %10, ptr %16, align 8
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: if.exit.try:                                      ; preds = %if.exit
// CHECK-NEXT:   store i32 %errorTraceGlobal.idx, ptr @dmz_error_trace, align 4
// CHECK-NEXT:   %17 = getelementptr inbounds nuw %error.struct.i32, ptr %struct.ret.tmp, i32 0, i32 0
// CHECK-NEXT:   %18 = load i32, ptr %17, align 4
// CHECK-NEXT:   store i32 %18, ptr %ret, align 4
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %if.exit.try, %error_trace.merge2, %error_trace.merge
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

extern fn dprintf(fd: i32, fmt: *u8, ...) -> i32;

fn voiderr(n: i32) -> !void {
    if (n == 0) {
        return e.ERROR_THREE;
    }
}

fn main() -> void {
    let result = foo(10);
    let result2 = bar(2);
    dprintf(1, "%d\n", try result);
    result2 catch |result_e| {
        dprintf(1, "%s\n", result_e);
    };

    let result_error = false;
    result catch |err1| {
        dprintf(1, "%s\n", err1);
        result_error = true;
    };

    if (!result_error) {
        dprintf(1, "There was no error\n");
    }

    dprintf(1, "%d\n", try result);

    result catch {
        dprintf(1, "There are an error\n");
    };
    foo(1) catch {
        dprintf(1, "There are an error\n");
    };

    dprintf(1, "No error %d\n", try result);
    dprintf(1, "No safe error %d\n", try foo(10));
}
// CHECK: define void @__builtin_main() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %result = alloca %error.struct.i32, align 8
// CHECK-NEXT:   %struct.ret.tmp = alloca %error.struct.i32, align 8
// CHECK-NEXT:   %result2 = alloca %error.struct.i32, align 8
// CHECK-NEXT:   %struct.ret.tmp1 = alloca %error.struct.i32, align 8
// CHECK-NEXT:   %catch_result = alloca i32, align 4
// CHECK-NEXT:   %result_e = alloca ptr, align 8
// CHECK-NEXT:   %result_error = alloca i1, align 1
// CHECK-NEXT:   %catch_result5 = alloca i32, align 4
// CHECK-NEXT:   %err1 = alloca ptr, align 8
// CHECK-NEXT:   %catch_result15 = alloca i32, align 4
// CHECK-NEXT:   %catch_result19 = alloca i32, align 4
// CHECK-NEXT:   %struct.ret.tmp20 = alloca %error.struct.i32, align 8
// CHECK-NEXT:   %struct.ret.tmp27 = alloca %error.struct.i32, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %result, i8 0, i64 16, i1 false)
