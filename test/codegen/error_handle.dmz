// CHECK-NEXT:   store %ErrorTraceEntry { %slice.struct { ptr @global.str.trace.data, i64 49 }, i32 140, i32 24, %slice.struct { ptr @global.str.trace.data.4, i64 17 } }, ptr %5, align 8
// CHECK-NEXT:   %6 = add i32 %3, 1
// CHECK-NEXT:   store i32 %6, ptr @dmz_error_trace, align 4
