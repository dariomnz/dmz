// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
const Token = enum {
    val1,
    val2,
    val3 = 3,
    val4,

    pub fn print(self: *@This) -> void {
        printf("Token: %d\n", self.*);
    }
};

extern fn printf(fmt:*u8, ...) -> i32;

fn main() -> void {
    let t2: Token = Token.val2;
    let t3 = Token.val3;
    let t4: Token = Token.val4;
    t2.print();
    t3.print();
    t4.print();

    let val: i32 = t4;
    let val2: Token = val;
    val2.print();
}

// CHECK: define void @enum_member.Token.print(ptr byref(i32) %0) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %self = alloca ptr, align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %self, i8 0, i64 8, i1 false)
// CHECK-NEXT:   store ptr %0, ptr %self, align 8
// CHECK-NEXT:   %1 = load ptr, ptr %self, align 8
// CHECK-NEXT:   %2 = load i32, ptr %1, align 4
// CHECK-NEXT:   %3 = call i32 (ptr, ...) @printf(ptr byref(i8) @string.literal.C8CD15B2, i32 %2)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }