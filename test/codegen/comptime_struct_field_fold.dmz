// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: diff <(dmz %s -run 2>&1) <(echo -n -e '50\n')

const Point = struct {
    x: i32,
    y: i32,
};

extern fn printf(fmt: *u8, ...) -> i32;
fn println(n: i32) -> void { printf("%d\n", n); }

fn main() -> void {
    const val = comptime Point{x: 10, y: 20}.y + comptime Point{x: 30, y: 40}.x;
    println(val);
}
// CHECK: call void @comptime_struct_field_fold.println(i32 50)
