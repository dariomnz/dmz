// RUN: dmz %s -run 2>&1 | filecheck %s
extern fn printf(fmt: *u8, ...) -> i32;
extern fn malloc(size: usize) -> *u8;
extern fn free(ptr: *u8) -> void;

fn foo(i: i32) -> *fn()->void {
    let f1 = [i]() -> void { printf("x: %d\n", i); };
    return f1;
}

fn main() -> void {
    let funcs_data: *void = malloc(10 * @sizeof(*fn()->void));
    let funcs: **fn()->void = funcs_data;
    for (0..10) |i| {
        funcs[i] = foo(i);
    }

    for (0..10) |i| {
        funcs[i]();
    }

    free(funcs_data);
}
