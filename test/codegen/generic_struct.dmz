// RUN: dmz %s -llvm-dump 2>&1 | filecheck %s
// RUN: diff <(dmz %s -run 2>&1) <(echo -n -e 'Point 1 2\n')

extern fn printf(fmt: *u8, ...) -> i32;

fn Point(comptime T: type) -> type {
    return struct {
        x: T,
        y: T,
    };
}
// CHECK: %"generic_struct.struct.Point(f64)" = type { double, double }
// CHECK: %"generic_struct.struct.Point(i32)" = type { i32, i32 }

fn main() -> void {
    let p1 = Point(f64){x: 1.0, y: 2.0};
    let p: Point(i32) = Point(i32){x: 1, y: 2};
    p.x = 1;
    p.y = 2;
    printf("Point %d %d\n", p.x, p.y);
}
// CHECK: define void @__builtin_main() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %p1 = alloca %"generic_struct.struct.Point(f64)", align 8
// CHECK-NEXT:   %"tmp.struct.generic_struct.struct.Point(f64)" = alloca %"generic_struct.struct.Point(f64)", align 8
// CHECK-NEXT:   %p = alloca %"generic_struct.struct.Point(i32)", align 8
// CHECK-NEXT:   %"tmp.struct.generic_struct.struct.Point(i32)" = alloca %"generic_struct.struct.Point(i32)", align 8
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %p1, i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %"tmp.struct.generic_struct.struct.Point(f64)", i8 0, i64 16, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %p, i8 0, i64 8, i1 false)
// CHECK-NEXT:   call void @llvm.memset.inline.p0.i64(ptr align 8 %"tmp.struct.generic_struct.struct.Point(i32)", i8 0, i64 8, i1 false)
// CHECK-NEXT:   store %"generic_struct.struct.Point(f64)" { double 1.000000e+00, double 2.000000e+00 }, ptr %"tmp.struct.generic_struct.struct.Point(f64)", align 8
// CHECK-NEXT:   call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %p1, ptr align 8 %"tmp.struct.generic_struct.struct.Point(f64)", i64 16, i1 false)
// CHECK-NEXT:   store %"generic_struct.struct.Point(i32)" { i32 1, i32 2 }, ptr %"tmp.struct.generic_struct.struct.Point(i32)", align 4
// CHECK-NEXT:   call void @llvm.memcpy.inline.p0.p0.i64(ptr align 4 %p, ptr align 4 %"tmp.struct.generic_struct.struct.Point(i32)", i64 8, i1 false)
// CHECK-NEXT:   %0 = getelementptr inbounds nuw %"generic_struct.struct.Point(i32)", ptr %p, i32 0, i32 0
// CHECK-NEXT:   store i32 1, ptr %0, align 4
// CHECK-NEXT:   %1 = getelementptr inbounds nuw %"generic_struct.struct.Point(i32)", ptr %p, i32 0, i32 1
// CHECK-NEXT:   store i32 2, ptr %1, align 4
// CHECK-NEXT:   %2 = getelementptr inbounds nuw %"generic_struct.struct.Point(i32)", ptr %p, i32 0, i32 0
// CHECK-NEXT:   %3 = load i32, ptr %2, align 4
// CHECK-NEXT:   %4 = getelementptr inbounds nuw %"generic_struct.struct.Point(i32)", ptr %p, i32 0, i32 1
// CHECK-NEXT:   %5 = load i32, ptr %4, align 4
// CHECK-NEXT:   %6 = call i32 (ptr, ...) @printf(ptr byref(i8) @string.literal.8B0291C3, i32 %3, i32 %5)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }