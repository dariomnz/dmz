// RUN: dmz %s -ast-dump 2>&1 | filecheck %s
const Token = enum {
    val1,
    val2,
    val3 = 3,
    val4,
};

fn main() -> void {
    let t1 = Token.val1;
    let t2 = Token.val2;
    let t3 = Token.val3;
    let t4 = Token.val4;
}
// CHECK: VarDecl:const  Token global
// CHECK-NEXT:       EnumDecl enumL2C14
// CHECK-NEXT:         FieldDecl: val1
// CHECK-NEXT:         FieldDecl: val2
// CHECK-NEXT:         FieldDecl: val3
// CHECK-NEXT:           IntLiteral '3'
// CHECK-NEXT:         FieldDecl: val4
// CHECK:         VarDecl: t1
// CHECK-NEXT:           MemberExpr .val1
// CHECK-NEXT:             DeclRefExpr Token
