// RUN: dmz %s -ast-dump 2>&1 | filecheck %s
const Empty = struct {};
// CHECK: VarDecl:const  Empty global
// CHECK-NEXT:   StructDecl structL2C14

const WithTrailingComma = struct {
    r: i32,
    g: i32,
    b: i32,
};
// CHECK: VarDecl:const  WithTrailingComma global
// CHECK-NEXT:   StructDecl structL6C26
// CHECK-NEXT:   FieldDecl:i32 r
// CHECK-NEXT:   FieldDecl:i32 g
// CHECK-NEXT:   FieldDecl:i32 b

const WithoutTrailingComma = struct {
    a: i32,
    b: i32,
    c: i32
};
// CHECK: VarDecl:const  WithoutTrailingComma global
// CHECK-NEXT:   StructDecl structL17C29
// CHECK-NEXT:   FieldDecl:i32 a
// CHECK-NEXT:   FieldDecl:i32 b
// CHECK-NEXT:   FieldDecl:i32 c
