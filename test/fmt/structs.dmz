// RUN: dmz -fmt %s 2>&1 | filecheck %s --match-full-lines --strict-whitespace

pub const S = struct {
    a: i32,
    b: f32,
};

const Nested = struct {
    inner: struct {
        x: i32,
    },
};

const PackedS = packed struct {
    a: i8,
};

const UnionT = union {
    a: i32,
    b: f32,
};

fn GenericS(comptime T: type) -> type {
    return struct {
        val: T,
    };
}

const WithMethod = struct {
    a: i32,
    pub fn get_a(self: *WithMethod) -> i32 {
        return self.a;
    }
};

