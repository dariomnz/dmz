// RUN: dmz %s -res-dump 2>&1 | filecheck %s
extern fn printf(fmt:*u8, ...) -> i32;

fn main() -> void {
    inline for (0..3) |x| {
        printf("%d\n", x);
    }
}

// CHECK:       ResolvedInlineForStmt
// CHECK-NEXT:         ResolvedRangeExpr
// CHECK-NEXT:           ResolvedIntLiteral:i32 '0'
// CHECK-NEXT:           | value: 0
// CHECK-NEXT:           ResolvedIntLiteral:i32 '3'
// CHECK-NEXT:           | value: 3
// CHECK-NEXT:         ResolvedCaptureDecl:generic x
// CHECK-NEXT:         ResolvedBlock
// CHECK-NEXT:           ResolvedBlock
// CHECK-NEXT:             ResolvedDeclStmt i64
// CHECK-NEXT:               ResolvedVarDecl:const i64 x
// CHECK-NEXT:                 ResolvedIntLiteral:i64 '0'
// CHECK-NEXT:                 | value: 0
// CHECK-NEXT:             ResolvedCallExpr:i32
// CHECK-NEXT:               ResolvedDeclRefExpr:fn(*u8, ...)->i32 printf
// CHECK-NEXT:               ResolvedStringLiteral:*u8 '%d\n'
// CHECK-NEXT:               ResolvedDeclRefExpr:i64 x
// CHECK-NEXT:               | value: 0
// CHECK-NEXT:           ResolvedBlock
// CHECK-NEXT:             ResolvedDeclStmt i64
// CHECK-NEXT:               ResolvedVarDecl:const i64 x
// CHECK-NEXT:                 ResolvedIntLiteral:i64 '1'
// CHECK-NEXT:                 | value: 1
// CHECK-NEXT:             ResolvedCallExpr:i32
// CHECK-NEXT:               ResolvedDeclRefExpr:fn(*u8, ...)->i32 printf
// CHECK-NEXT:               ResolvedStringLiteral:*u8 '%d\n'
// CHECK-NEXT:               ResolvedDeclRefExpr:i64 x
// CHECK-NEXT:               | value: 1
// CHECK-NEXT:           ResolvedBlock
// CHECK-NEXT:             ResolvedDeclStmt i64
// CHECK-NEXT:               ResolvedVarDecl:const i64 x
// CHECK-NEXT:                 ResolvedIntLiteral:i64 '2'
// CHECK-NEXT:                 | value: 2
// CHECK-NEXT:             ResolvedCallExpr:i32
// CHECK-NEXT:               ResolvedDeclRefExpr:fn(*u8, ...)->i32 printf
// CHECK-NEXT:               ResolvedStringLiteral:*u8 '%d\n'
// CHECK-NEXT:               ResolvedDeclRefExpr:i64 x
// CHECK-NEXT:               | value: 2