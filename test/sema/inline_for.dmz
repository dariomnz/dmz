// RUN: dmz %s -res-dump 2>&1 | filecheck %s

fn main() -> void {
    let t = .{1, 2};
    inline for (t) |x| {
        let y = x;
    }
}
// CHECK: ResolvedModuleDecl inline_for
// CHECK-NEXT:   ResolvedFunctionDecl main fn()->void
// CHECK-NEXT:     ResolvedBlock
// CHECK-NEXT:       ResolvedDeclStmt tuple.i32.i32{}
// CHECK-NEXT:         ResolvedVarDecl:tuple.i32.i32{} t
// CHECK-NEXT:         | value: {elem0: 1, elem1: 2}
// CHECK-NEXT:           ResolvedTupleInstantiationExpr:tuple.i32.i32{}
// CHECK-NEXT:             ResolvedFieldInitStmt:i32 elem0
// CHECK-NEXT:               ResolvedIntLiteral:i32 '1'
// CHECK-NEXT:               | value: 1
// CHECK-NEXT:             ResolvedFieldInitStmt:i32 elem1
// CHECK-NEXT:               ResolvedIntLiteral:i32 '2'
// CHECK-NEXT:               | value: 2
// CHECK-NEXT:       ResolvedInlineForStmt
// CHECK-NEXT:         ResolvedDeclRefExpr:tuple.i32.i32{} t
// CHECK-NEXT:         ResolvedCaptureDecl:anytype x
// CHECK-NEXT:         ResolvedBlock
// CHECK-NEXT:           ResolvedBlock
// CHECK-NEXT:             ResolvedDeclStmt i32
// CHECK-NEXT:               ResolvedVarDecl:const i32 x
// CHECK-NEXT:                 ResolvedMemberExpr:i32 elem0
// CHECK-NEXT:                   ResolvedDeclRefExpr:tuple.i32.i32{} t
// CHECK-NEXT:             ResolvedDeclStmt i32
// CHECK-NEXT:               ResolvedVarDecl:i32 y
// CHECK-NEXT:                 ResolvedDeclRefExpr:i32 x
// CHECK-NEXT:           ResolvedBlock
// CHECK-NEXT:             ResolvedDeclStmt i32
// CHECK-NEXT:               ResolvedVarDecl:const i32 x
// CHECK-NEXT:                 ResolvedMemberExpr:i32 elem1
// CHECK-NEXT:                   ResolvedDeclRefExpr:tuple.i32.i32{} t
// CHECK-NEXT:             ResolvedDeclStmt i32
// CHECK-NEXT:               ResolvedVarDecl:i32 y
// CHECK-NEXT:                 ResolvedDeclRefExpr:i32 x