// RUN: dmz %s -res-dump 2>&1 | filecheck %s
fn main() -> void {
    let a = 10;
    let t = @typeid(a);
}
// CHECK:   ResolvedVarDecl:i32 t
// CHECK-NEXT:     ResolvedCallExpr:i32
// CHECK-NEXT:     | value: 1
// CHECK-NEXT:       ResolvedDeclRefExpr:i32 @typeid
// CHECK-NEXT:       ResolvedDeclRefExpr:i32 a