// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s

fn main() -> void {
    const a = 1;
    const b = 2;
    
    const c = a << b;
    const d = a >> b;
    const e = a & b;
    const f = a | b;
    const g = a ^ b;
    const h = ~a;
}

// CHECK:         ResolvedVarDecl:const i32 c
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '<<'
// CHECK-NEXT:           | value: 4
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 b
// CHECK-NEXT:             | value: 2

// CHECK:         ResolvedVarDecl:const i32 d
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '>>'
// CHECK-NEXT:           | value: 0
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 b
// CHECK-NEXT:             | value: 2

// CHECK:         ResolvedVarDecl:const i32 e
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '&'
// CHECK-NEXT:           | value: 0
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 b
// CHECK-NEXT:             | value: 2

// CHECK:         ResolvedVarDecl:const i32 f
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '|'
// CHECK-NEXT:           | value: 3
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 b
// CHECK-NEXT:             | value: 2

// CHECK:         ResolvedVarDecl:const i32 g
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '^'
// CHECK-NEXT:           | value: 3
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 b
// CHECK-NEXT:             | value: 2

// CHECK:         ResolvedVarDecl:const i32 h
// CHECK-NEXT:           ResolvedUnaryOperator:i32 '~'
// CHECK-NEXT:           | value: -2
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 1