// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s
const S = struct {
    x: i32,
};
const S2 = struct {
    x: i32,
};

fn main() -> void {
    let s = S{x: 0};
    let s2 = S2{x: 0};

    s.x = 1;
    s2.x = s2;
    // CHECK: [[# @LINE - 1 ]]:12: error: assigned value type 'member_expr_assignment.S2{}' doesn't match variable type 'i32'
}