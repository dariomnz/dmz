// RUN: dmz %s -res-dump 2>&1 | filecheck %s

fn id(comptime T: type, val: T) -> T {
    return val;
}

fn main() -> void {
    let a = id(i32, 10);
    let b = id(bool, true);
}

// CHECK: ResolvedCallExpr:i32
// CHECK-NEXT:   ResolvedDeclRefExpr:fn(type, i32)->i32 id
// CHECK: ResolvedCallExpr:bool
// CHECK-NEXT:   ResolvedDeclRefExpr:fn(type, bool)->bool id
