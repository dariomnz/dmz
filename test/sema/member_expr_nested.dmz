// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s

fn main() -> void {
    
    const S2 = struct {
        x: i32,
    };

    const S = struct {
        x: i32,
        n: S2,
    };

    let s = S{x: 0, n: S2{x: 1}};

    let x = s.n.x;
}

// CHECK: ResolvedFunctionDecl main fn()->void
// CHECK-NEXT:   ResolvedBlock

// CHECK: ResolvedStructDecl  member_expr_nested.structL5C15.S2
// CHECK-NEXT:   ResolvedFieldDecl:i32 x
// CHECK: ResolvedStructDecl member_expr_nested.structL9C14.S
// CHECK-NEXT:   ResolvedFieldDecl:i32 x
// CHECK-NEXT:   ResolvedFieldDecl:member_expr_nested.structL5C15.S2{} n

// CHECK:       ResolvedVarDecl:member_expr_nested.structL9C14.S{} s
// CHECK-NEXT:       | value: {x: 0, n: {x: 1}}
// CHECK-NEXT:         ResolvedStructInstantiationExpr:member_expr_nested.structL9C14.S{}
// CHECK-NEXT:           ResolvedFieldInitStmt:i32 x
// CHECK-NEXT:             ResolvedIntLiteral:i32 '0'
// CHECK-NEXT:             | value: 0
// CHECK-NEXT:           ResolvedFieldInitStmt:member_expr_nested.structL5C15.S2{} n
// CHECK-NEXT:             ResolvedStructInstantiationExpr:member_expr_nested.structL5C15.S2{}
// CHECK-NEXT:               ResolvedFieldInitStmt:i32 x
// CHECK-NEXT:                 ResolvedIntLiteral:i32 '1'
// CHECK-NEXT:                 | value: 1
// CHECK-NEXT:     ResolvedDeclStmt
// CHECK-NEXT:       ResolvedVarDecl:i32 x
// CHECK-NEXT:         ResolvedMemberExpr:i32 x
// CHECK-NEXT:           ResolvedMemberExpr:member_expr_nested.structL5C15.S2{} n
// CHECK-NEXT:             ResolvedDeclRefExpr:member_expr_nested.structL9C14.S{} s
