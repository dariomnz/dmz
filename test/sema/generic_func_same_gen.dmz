// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedCallExpr:i32
// CHECK-NEXT:             ResolvedDeclRefExpr:fn(i32)->i32 print3
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 scalar
// CHECK-NEXT:   ResolvedGenericFunctionDecl print3 fn(anytype)->i32
// CHECK-NEXT:     ResolvedParamDecl:anytype scalar
// CHECK-NEXT:     ResolvedBlock
// CHECK-NEXT:       ResolvedReturnStmt
// CHECK-NEXT:         ResolvedCallExpr:i32
// CHECK-NEXT:           ResolvedDeclRefExpr:fn(*u8, ...)->i32 printf
// CHECK-NEXT:           ResolvedStringLiteral:*u8 'value %d\n'
// CHECK-NEXT:           | value: 'value %d\n'
// CHECK-NEXT:           ResolvedDeclRefExpr:anytype scalar
// CHECK-NEXT:     ResolvedSpecializedFunctionDecl print3(i32) fn(i32)->i32
