// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s

extern fn printf(fmt: *u8, ...) -> i32;

pub fn print(scalar: anytype) -> i32 {
    return print2(scalar);
}

fn print2(scalar: anytype) -> i32 {
    return print3(scalar);
}

fn print3(scalar: anytype) -> i32 {
    return printf("value %d\n", scalar);
}

fn main() -> void {
    print(123);
}
// CHECK: ResolvedModuleDecl generic_func_same_gen
// CHECK-NEXT:   ResolvedExternFunctionDecl printf fn(*u8, ...)->i32
// CHECK-NEXT:     ResolvedParamDecl:*u8 fmt
// CHECK-NEXT:     ResolvedParamDecl:vararg ...
// CHECK-NEXT:   ResolvedGenericFunctionDecl print fn(anytype)->i32
// CHECK-NEXT:     ResolvedParamDecl:anytype scalar
// CHECK-NEXT:     ResolvedBlock
// CHECK-NEXT:       ResolvedReturnStmt
// CHECK-NEXT:         ResolvedCallExpr:i32
// CHECK-NEXT:           ResolvedDeclRefExpr:fn(anytype)->i32 print2
// CHECK-NEXT:           ResolvedDeclRefExpr:anytype scalar
// CHECK-NEXT:     ResolvedSpecializedFunctionDecl print(i32) fn(i32)->i32
// CHECK-NEXT:       ResolvedParamDecl:i32 scalar
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedCallExpr:i32
// CHECK-NEXT:             ResolvedDeclRefExpr:fn(i32)->i32 print2
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 scalar
// CHECK-NEXT:   ResolvedGenericFunctionDecl print2 fn(anytype)->i32
// CHECK-NEXT:     ResolvedParamDecl:anytype scalar
// CHECK-NEXT:     ResolvedBlock
// CHECK-NEXT:       ResolvedReturnStmt
// CHECK-NEXT:         ResolvedCallExpr:i32
// CHECK-NEXT:           ResolvedDeclRefExpr:fn(anytype)->i32 print3
// CHECK-NEXT:           ResolvedDeclRefExpr:anytype scalar
// CHECK-NEXT:     ResolvedSpecializedFunctionDecl print2(i32) fn(i32)->i32
// CHECK-NEXT:       ResolvedParamDecl:i32 scalar
