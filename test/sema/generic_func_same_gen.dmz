// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s

extern fn printf(fmt: *u8, ...) -> i32;

pub fn print<T>(scalar: T) -> i32 {
    return print2<T>(scalar);
}

fn print2<T>(scalar: T) -> i32 {
    return print3<T>(scalar);
}

fn print3<T>(scalar: T) -> i32 {
    return printf("value %d\n", scalar);
}

fn main() -> void {
    print<i32>(123);
}
// CHECK: ResolvedModuleDecl generic_func_same_gen
