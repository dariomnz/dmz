// CHECK-NEXT:             ResolvedDeclRefExpr:fn(*u8, ...)->i32 printf
// CHECK-NEXT:             ResolvedStringLiteral:*u8 'value %d\n'
// CHECK-NEXT:             | value: 'value %d\n'
