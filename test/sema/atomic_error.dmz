// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s

const Point = struct {
    x: i32,
    y: i32,
};

fn main() -> void {
    let i: i32 = 42;
    let ptr: *i32 = &i;

    let x = 10;
    // CHECK: [[# @LINE + 1 ]]:17: error: expected pointer type for @atomicLoad, actual 'i32'
    @atomicLoad(x);

    // CHECK: [[# @LINE + 2 ]]:5: error: atomic RMW operation 'Add' only supported for numeric or pointer types, actual 'atomic_error.Point{}'
    let p: Point = Point{x: 1, y: 2};
    @atomicRmw(&p, .Add, p);

}
