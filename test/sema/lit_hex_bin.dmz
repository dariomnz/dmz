// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s

fn main() -> void {
    const a = 0x10;
    const b = 0b1010;
    const c = 0x123;
    const d = 0b11;
}

// CHECK:         ResolvedVarDecl:const i32 a
// CHECK-NEXT:           ResolvedIntLiteral:i32
// CHECK-NEXT:           | value: 16

// CHECK:         ResolvedVarDecl:const i32 b
// CHECK-NEXT:           ResolvedIntLiteral:i32
// CHECK-NEXT:           | value: 10

// CHECK:         ResolvedVarDecl:const i32 c
// CHECK-NEXT:           ResolvedIntLiteral:i32
// CHECK-NEXT:           | value: 291

// CHECK:         ResolvedVarDecl:const i32 d
// CHECK-NEXT:           ResolvedIntLiteral:i32
// CHECK-NEXT:           | value: 3
