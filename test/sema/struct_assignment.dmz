// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s
const S = struct {
    x: i32,
};

const S2 = struct {
    x: i32,
};

fn main() -> void {
    let s = S{x: 0};
    let s2 = S2{x: 0};

    s = s;
    s = s2;
    // CHECK: [[# @LINE - 1 ]]:9: error: assigned value type 'struct_assignment.S2{}' doesn't match variable type 'struct_assignment.S{}'
}