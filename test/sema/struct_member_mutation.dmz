// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s
const S = struct {
    x: i32,
};

const S2 = struct {
    x: i32,
    s: S,
};

fn foo() -> S {
    return S{x: 1};
}

fn bar(structParam: S) -> void {
    foo().x = 1;
    S{x: 1}.x = 2;

    let s2 = S2{x: 0, s: S{x: 0}};
    s2.s.x = 1;

    const s = S{x: 1};
    s.x = 3;
    // CHECK: [[# @LINE - 1 ]]:9: error: 's' cannot be mutated

    structParam.x = 3;
    // CHECK: [[# @LINE - 1 ]]:19: error: 'structParam' cannot be mutated
}

fn main() -> void {
}