// CHECK-NEXT:                        ResolvedDeclRefExpr:fn(*u8, ...)->i32 printf
// CHECK-NEXT:                        ResolvedStringLiteral:*u8 '%d '
// CHECK-NEXT:                        | value: '%d '
// CHECK-NEXT:                        ResolvedArrayAtExpr:T
// CHECK-NEXT:                          ResolvedMemberExpr:[0]T data
// CHECK-NEXT:                            ResolvedDerefPtrExpr:comptime_param_struct.struct.array(T){}
// CHECK-NEXT:                              ResolvedDeclRefExpr:*comptime_param_struct.struct.array(T){} self
