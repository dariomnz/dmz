// CHECK-NEXT:            ResolvedStructDecl comptime_param_struct.struct.array(T)
// CHECK-NEXT:              ResolvedFieldDecl:[0]T data
// CHECK-NEXT:              ResolvedMemberFunctionDecl print fn(*comptime_param_struct.struct.array(T){})->void
// CHECK-NEXT:                ResolvedParamDecl:*comptime_param_struct.struct.array(T){} self
// CHECK-NEXT:                ResolvedBlock
// CHECK-NEXT:                  ResolvedForStmt
// CHECK-NEXT:                    ResolvedRangeExpr
// CHECK-NEXT:                      ResolvedIntLiteral:i32 '0'
// CHECK-NEXT:                      | value: 0
// CHECK-NEXT:                      ResolvedDeclRefExpr:i32 size
// CHECK-NEXT:                    ResolvedCaptureDecl:i32 i
// CHECK-NEXT:                    ResolvedBlock
