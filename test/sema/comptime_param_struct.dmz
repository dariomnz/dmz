// RUN: dmz %s -res-dump 2>&1 | filecheck %s

extern fn printf(fmt: *u8, ...) -> i32;

fn array(comptime T: type, comptime size: i32) -> type {
    return struct {
        data: [size]T,

        pub fn print(self: *@This) -> void {
            for (0..size) |i| {
                printf("%d ", self.data[i]);
            }
            printf("\n");
        }
    };
}
// CHECK:ResolvedGenericFunctionDecl array fn(T, i32)->type
