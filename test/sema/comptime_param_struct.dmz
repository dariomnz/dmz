const arr3 = array(i32, 3);
const arr5 = array(i32, 5);

fn main() -> void {
    const v3: arr3 = arr3{data: {1, 2, 3}};
    v3.data[0] = 123;
    v3.print();
    const v5: arr5 = arr5{data: {1, 2, 3, 4, 5}};
    v5.data[0] = 123;
    v5.print();
}

