// RUN: dmz %s -res-dump 2>&1 | filecheck %s

fn add_comptime(comptime a: i32, comptime b: i32) -> i32 {
    return a + b;
}
// CHECK:     ResolvedSpecializedFunctionDecl add_comptime(10, 30) fn(i32, i32)->i32
// CHECK-NEXT:       ResolvedParamDecl:comptime i32 a
// CHECK-NEXT:       ResolvedParamDecl:comptime i32 b
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '+'
// CHECK-NEXT:           | value: 40
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 a
// CHECK-NEXT:             | value: 10
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 b
// CHECK-NEXT:             | value: 30

fn mul_comptime_mixed(comptime factor: i32, x: i32) -> i32 {
    return factor * x;
}
// CHECK:     ResolvedSpecializedFunctionDecl mul_comptime_mixed(5) fn(i32, i32)->i32
// CHECK-NEXT:       ResolvedParamDecl:comptime i32 factor
// CHECK-NEXT:       ResolvedParamDecl:i32 x
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '*'
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 factor
// CHECK-NEXT:             | value: 5
// CHECK-NEXT:             ResolvedDeclRefExpr:i32 x

fn main() -> void {
    const x = add_comptime(10, 30);
    const y = mul_comptime_mixed(5, 100);
}
