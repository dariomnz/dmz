// RUN: dmz %s -res-dump 2>&1 | filecheck %s

const S = struct {
    a: i32,
    pub fn foo(s: *@This) -> void {}
};

fn main() -> void {
    let s: S = {};
    const hasFoo = @hasMethod(s, "foo");
    const hasBar = @hasMethod(s, "bar");
}
// CHECK:         ResolvedVarDecl:const bool hasFoo
// CHECK-NEXT:         | value: 1
// CHECK-NEXT:           ResolvedCallExpr:bool
// CHECK-NEXT:           | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:bool @hasMethod
// CHECK-NEXT:             | value: 1
// CHECK-NEXT:             ResolvedDeclRefExpr:has_method.S{} s
// CHECK-NEXT:             ResolvedStringLiteral:*u8 'foo'

// CHECK:         ResolvedVarDecl:const bool hasBar
// CHECK-NEXT:         | value: 0
// CHECK-NEXT:           ResolvedCallExpr:bool
// CHECK-NEXT:           | value: 0
// CHECK-NEXT:             ResolvedDeclRefExpr:bool @hasMethod
// CHECK-NEXT:             | value: 0
// CHECK-NEXT:             ResolvedDeclRefExpr:has_method.S{} s
// CHECK-NEXT:             ResolvedStringLiteral:*u8 'bar'