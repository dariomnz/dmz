// RUN: dmz %s -res-dump 2>&1 | filecheck %s
const Token = enum {
    val1,
    val2,
    val3 = 3,
    val4,
};

fn foo(val: Token) -> i32 {
    return 0;
}

fn main() -> void {
    let t2: Token = Token.val2;
    let t3 = Token.val3;
    let t4: Token = .val4;

    foo(.val2);
}
// CHECK: ResolvedVarDecl:const enum_auto.Token Token
// CHECK-NEXT:     | value: enum_auto.Token
// CHECK-NEXT:     ResolvedTypeExpr:enum_auto.Token
// CHECK-NEXT:     | value: enum_auto.Token
// CHECK-NEXT:   ResolvedTypeEnumDecl enum_auto.Token
// CHECK-NEXT:     ResolvedEnumDecl enum_auto.Token
// CHECK-NEXT:       ResolvedFieldDecl:enum_auto.Token{} val1
// CHECK-NEXT:       | value: 0
// CHECK-NEXT:       ResolvedFieldDecl:enum_auto.Token{} val2
// CHECK-NEXT:       | value: 1
// CHECK-NEXT:       ResolvedFieldDecl:enum_auto.Token{} val3
// CHECK-NEXT:       | value: 3
// CHECK-NEXT:         ResolvedIntLiteral:i32 '3'
// CHECK-NEXT:         | value: 3
// CHECK-NEXT:       ResolvedFieldDecl:enum_auto.Token{} val4
// CHECK-NEXT:       | value: 4
// CHECK: ResolvedDeclStmt enum_auto.Token{}
// CHECK-NEXT:  ResolvedVarDecl:enum_auto.Token{} t2
// CHECK-NEXT:         | value: 1
// CHECK-NEXT:    ResolvedMemberExpr:enum_auto.Token{} val2
// CHECK-NEXT:    | value: 1
// CHECK-NEXT:      ResolvedDeclRefExpr:enum_auto.Token Token
// CHECK-NEXT:      | value: enum_auto.Token
// CHECK-NEXT:ResolvedDeclStmt enum_auto.Token{}
// CHECK-NEXT:  ResolvedVarDecl:enum_auto.Token{} t3
// CHECK-NEXT:         | value: 3
// CHECK-NEXT:    ResolvedMemberExpr:enum_auto.Token{} val3
// CHECK-NEXT:    | value: 3
// CHECK-NEXT:      ResolvedDeclRefExpr:enum_auto.Token Token
// CHECK-NEXT:      | value: enum_auto.Token
// CHECK-NEXT:ResolvedDeclStmt enum_auto.Token{}
// CHECK-NEXT:  ResolvedVarDecl:enum_auto.Token{} t4
// CHECK-NEXT:         | value: 4
// CHECK-NEXT:    ResolvedAutoMemberExpr .val4 enum_auto.Token{}
// CHECK-NEXT:    | value: 4
// CHECK-NEXT:ResolvedCallExpr:i32
// CHECK-NEXT:  ResolvedDeclRefExpr:fn(enum_auto.Token{})->i32 foo
// CHECK-NEXT:  ResolvedAutoMemberExpr .val2 enum_auto.Token{}
// CHECK-NEXT:  | value: 1