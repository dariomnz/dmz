// RUN: dmz %s -res-dump 2>&1 | filecheck %s

fn force_comptime() -> i32 {
    return comptime 10 + 20;
}

// CHECK:     ResolvedFunctionDecl force_comptime fn()->i32
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedBinaryOperator:i32 '+'
// CHECK-NEXT:           | value: 30
// CHECK-NEXT:             ResolvedComptimeExpr:i32
// CHECK-NEXT:             | value: 10
// CHECK-NEXT:               ResolvedIntLiteral:i32 '10'

fn comptime_bool_expr() -> bool {
    return comptime true && false;
}

// CHECK:     ResolvedFunctionDecl comptime_bool_expr fn()->bool
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedBinaryOperator:bool '&&'
// CHECK-NEXT:           | value: false
// CHECK-NEXT:             ResolvedComptimeExpr:bool
// CHECK-NEXT:             | value: true
// CHECK-NEXT:               ResolvedBoolLiteral:bool 'true'
// CHECK-NEXT:             ResolvedBoolLiteral:bool 'false'

fn comptime_float_expr() -> f64 {
    return comptime 3.14 * 2.0;
}

// CHECK:     ResolvedFunctionDecl comptime_float_expr fn()->f64
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedReturnStmt
// CHECK-NEXT:           ResolvedBinaryOperator:f64 '*'
// CHECK-NEXT:           | value: 6.28
// CHECK-NEXT:             ResolvedComptimeExpr:f64
// CHECK-NEXT:             | value: 3.14
// CHECK-NEXT:               ResolvedFloatLiteral:f64 '3.140000'
// CHECK-NEXT:             ResolvedFloatLiteral:f64 '2.000000'

fn main() -> void {
}
