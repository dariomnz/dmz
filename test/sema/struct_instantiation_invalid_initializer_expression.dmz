// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s
const S = struct {
    x: i32,
};

const S2 = struct {
};

fn main() -> void {
    S{x: S2{}};
    // CHECK: [[# @LINE - 1 ]]:10: error: 'struct_instantiation_invalid_initializer_expression.S2{}' cannot be used to initialize a field of type 'i32'
}