// RUN: (dmz %s -res-dump 2>&1 || true) | filecheck %s
const S = struct {
    x: i32,
};

fn main() -> void {
    let s = S{x: 1};

    s + 0;
    // CHECK: [[# @LINE - 1 ]]:5: error: 'struct_in_binop.S{}' cannot be used as LHS operand to binary operator

    0 + s;
    // CHECK: [[# @LINE - 1 ]]:9: error: 'struct_in_binop.S{}' cannot be used as RHS operand to binary operator
}