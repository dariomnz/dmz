// RUN: dmz %s -I std %S/../../std/std.dmz -res-dump -module -test 2>&1 | filecheck %s
const std = import("std");
const ops = import("module_ops.dmz");

fn add(x:i32, y:i32) -> i32 {
    return x + y;
}

test "add test" {
    try std.testing.expect(add(1, 1) == 2);
    try std.testing.expect(add(1, 1) == 3);
}
test "add test 2" {
    try std.testing.expect(add(1, 2) == 3);
    try std.testing.expect(add(2, 1) == 3);
}

// CHECK:  ResolvedTestDecl add test
// CHECK-NEXT:       ResolvedBlock
// CHECK-NEXT:         ResolvedTryErrorExpr:void
// CHECK-NEXT:           ResolvedCallExpr:!void
// CHECK-NEXT:             ResolvedMemberExpr:fn(i1)->!void expect
// CHECK-NEXT:               ResolvedMemberExpr:std.testing testing
// CHECK-NEXT:                 ResolvedDeclRefExpr:std std
// CHECK-NEXT:             ResolvedBinaryOperator:bool '=='
// CHECK-NEXT:               ResolvedCallExpr:i32
// CHECK-NEXT:                 ResolvedDeclRefExpr:fn(i32, i32)->i32 add
// CHECK-NEXT:                 ResolvedIntLiteral:i32 '1'
// CHECK-NEXT:                 | value: 1
// CHECK-NEXT:                 ResolvedIntLiteral:i32 '1'
// CHECK-NEXT:                 | value: 1
// CHECK-NEXT:               ResolvedIntLiteral:i32 '2'
// CHECK-NEXT:         ResolvedTryErrorExpr:void
// CHECK-NEXT:           ResolvedCallExpr:!void
// CHECK-NEXT:             ResolvedMemberExpr:fn(i1)->!void expect
// CHECK-NEXT:               ResolvedMemberExpr:std.testing testing
// CHECK-NEXT:                 ResolvedDeclRefExpr:std std
// CHECK-NEXT:             ResolvedBinaryOperator:bool '=='
// CHECK-NEXT:               ResolvedCallExpr:i32
// CHECK-NEXT:                 ResolvedDeclRefExpr:fn(i32, i32)->i32 add
// CHECK-NEXT:                 ResolvedIntLiteral:i32 '1'
// CHECK-NEXT:                 | value: 1
// CHECK-NEXT:                 ResolvedIntLiteral:i32 '1'
// CHECK-NEXT:                 | value: 1
// CHECK-NEXT:               ResolvedIntLiteral:i32 '3'

// CHECK:   ResolvedFunctionDecl __builtin_main_test fn()->void
// CHECK-NEXT:     ResolvedBlock
// CHECK-NEXT:       ResolvedDeclStmt usize
// CHECK-NEXT:         ResolvedVarDecl:const usize num_test
// CHECK-NEXT:           ResolvedCallExpr:usize
// CHECK-NEXT:           | value: 2
// CHECK-NEXT:             ResolvedDeclRefExpr:fn()->usize @testNum
// CHECK-NEXT:             | value: 2

// CHECK:         ResolvedVarDecl:const []u8 test_name
// CHECK-NEXT:           ResolvedCallExpr:[]u8
// CHECK-NEXT:             ResolvedDeclRefExpr:fn(usize)->[]u8 getTestName
// CHECK-NEXT:             ResolvedDeclRefExpr:usize i

// CHECK:         ResolvedVarDecl:const !void test_result
// CHECK-NEXT:           ResolvedCallExpr:!void
// CHECK-NEXT:             ResolvedDeclRefExpr:fn(usize)->!void runTest
// CHECK-NEXT:             ResolvedDeclRefExpr:usize i