// RUN: dmz %s -res-dump 2>&1 | filecheck %s

fn main() -> void {
    const a: @simd(i32, 4) = comptime @simdSplat(42);
    const b: @simd(i32, 4) = comptime @simdIota();
    const c: @simd(i32, 4) = comptime @simdSplat(10) + @simdSplat(20);
    const d: i32 = comptime (@simdIota() + @simdSplat(0))[2];
    const index_vec: @simd(u16, 8) = @simdIota();
    const match_mask: @simd(bool, 8) = @simdSplat(true);
    const matches: @simd(u16, 8) = comptime @simdSelect(index_vec, @simdSplat(8), match_mask);
    const arr: [4]i32 = {10, 20, 30, 40};
    const from_arr: @simd(i32, 4) = arr;
    let runtime_arr: [4]i32 = {100, 200, 300, 400};
    const from_runtime: @simd(i32, 4) = runtime_arr;
    const plus_one: @simd(i32, 4) = @simdSplat(1) + runtime_arr;
}

// CHECK: ResolvedVarDecl:const @simd(i32, 4) a
// CHECK-NEXT: | value: simd(42, 42, 42, 42)
// CHECK: ResolvedVarDecl:const @simd(i32, 4) b
// CHECK-NEXT: | value: simd(0, 1, 2, 3)
// CHECK: ResolvedVarDecl:const @simd(i32, 4) c
// CHECK-NEXT: | value: simd(30, 30, 30, 30)
// CHECK: ResolvedVarDecl:const i32 d
// CHECK-NEXT: | value: 2
// CHECK: ResolvedVarDecl:const @simd(u16, 8) index_vec
// CHECK-NEXT: | value: simd(0, 1, 2, 3, 4, 5, 6, 7)
// CHECK: ResolvedVarDecl:const @simd(bool, 8) match_mask
// CHECK-NEXT: | value: simd(true, true, true, true, true, true, true, true)
// CHECK: ResolvedVarDecl:const @simd(u16, 8) matches
// CHECK-NEXT: | value: simd(0, 1, 2, 3, 4, 5, 6, 7)
// CHECK: ResolvedVarDecl:const [4]i32 arr
// CHECK-NEXT: | value: {10, 20, 30, 40}
// CHECK: ResolvedVarDecl:const @simd(i32, 4) from_arr
// CHECK-NEXT: | value: simd(10, 20, 30, 40)
// CHECK: ResolvedVarDecl:const @simd(i32, 4) from_runtime
// CHECK: ResolvedVarDecl:const @simd(i32, 4) plus_one
