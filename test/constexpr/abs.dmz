// RUN: dmz %s -res-dump 2>&1 | filecheck %s

fn main() -> void {
    const a = comptime @abs(-5);
    const b = comptime @abs(3);
    const c = comptime @abs(-3.14);
    const d = comptime @abs(2.71);
}

// CHECK: ResolvedVarDecl:const i32 a
// CHECK-NEXT: | value: 5
// CHECK: ResolvedVarDecl:const i32 b
// CHECK-NEXT: | value: 3
// CHECK: ResolvedVarDecl:const f64 c
// CHECK-NEXT: | value: 3.14
// CHECK: ResolvedVarDecl:const f64 d
// CHECK-NEXT: | value: 2.71
