// RUN: dmz %s -test -run | filecheck %s

const std = import("std");

fn a() -> !void {
    return error.FailA;
}

fn b() -> !void {
    try a();
}

fn c() -> !void {
    try b();
}

test "error trace" {
    try c();
}

test "error trace 2" {
    try foo(12);
    try std.testing.expect(1 == 1);
}

fn foo(x: i32) -> !void {
    if (x >= 5) {
        try bar();
    } else {
        try bang2();
    }
}

fn bar() -> !void {
    baz() catch |er| {
        if (er == error.FileNotFound) try hello();
    };
}

fn baz() -> !void {
    try bang1();
}

fn quux() -> !void {
    try bang2();
}

fn hello() -> !void {
    try bang2();
}

fn bang1() -> !void {
    return error.FileNotFound;
}

fn bang2() -> !void {
    return error.PermissionDenied;
}

