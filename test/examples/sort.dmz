// RUN: dmz %s -run | filecheck %s

const std = import("std");

extern fn rand() -> i32;

fn checkSorted(slice: []i32, cmp: *fn(i32, i32)->bool) -> !void {
    for (0..slice.len - 1) |i| {
        if (!cmp(slice[i], slice[i + 1])) {
            std.io.print("Error: idx {}:{} values {}:{}\n", .{i, i + 1, slice[i], slice[i + 1]});
            return error.NotSorted;
        }
    }
}

fn main() -> void {
    const buff_size = 16 * 1024;
    const buffer: [buff_size]u8 = {};
    let arena = std.mem.Arena.init(buffer[0..buff_size]);
    let allocator = arena.allocator();

    const lambda = struct {
        pub fn comp(a: i32, b: i32) -> bool {
            return a <= b;
        }
    };
    const comp = &lambda.comp;

    const iters = 1000;
    {
        const start_allocated = arena.offset;
        let v = std.vec<i32>.init(allocator);
        defer v.deinit();

        const start_vector = std.time.get();
        for (0..iters) |i| {
            try v.add(rand() % iters);
        }
        const end_vector = std.time.get();
        std.io.print("Allocated in vector = {}\n", .{arena.offset - start_allocated});
        std.io.print("Time taken in vector {}: {} ms\n", .{v.size(), (end_vector - start_vector) * 1000.0});
        // CHECK: Allocated in vector = 4096
        {
            const start_sort = std.time.get();
            std.algorithm.bubbleSort<i32>(v.slice(), comp);
            const end_sort = std.time.get();
            std.io.print("Vector = {}\n", v.slice()[0..100]);
            // CHECK: Vector = [len: 100, 
            std.io.print("Time taken in sort vector {}: {} ms\n", .{v.size(), (end_sort - start_sort) * 1000.0});
            try checkSorted(v.slice(), comp);
        }
        {
            const start_sort = std.time.get();
            std.algorithm.bubbleSort<i32>(v.slice(), comp);
            const end_sort = std.time.get();
            std.io.print("Time taken in sort vector {}: {} ms\n", .{v.size(), (end_sort - start_sort) * 1000.0});
            try checkSorted(v.slice(), comp);
        }
    }
    {
        const start_allocated = arena.offset;
        let v = std.vec<i32>.init(allocator);
        defer v.deinit();

        const start_vector = std.time.get();
        for (0..iters) |i| {
            try v.add(rand() % iters);
        }
        const end_vector = std.time.get();
        std.io.print("Allocated in vector = {}\n", .{arena.offset - start_allocated});
        std.io.print("Time taken in vector {}: {} ms\n", .{v.size(), (end_vector - start_vector) * 1000.0});
        // CHECK: Allocated in vector = 4096
        {
            const start_sort = std.time.get();
            std.algorithm.quickSort<i32>(v.slice(), comp);
            const end_sort = std.time.get();
            std.io.print("Vector = {}\n", v.slice()[0..100]);
            // CHECK: Vector = [len: 100, 
            std.io.print("Time taken in sort vector {}: {} ms\n", .{v.size(), (end_sort - start_sort) * 1000.0});
            try checkSorted(v.slice(), comp);
        }
        {
            const start_sort = std.time.get();
            std.algorithm.quickSort<i32>(v.slice(), comp);
            const end_sort = std.time.get();
            std.io.print("Time taken in sort vector {}: {} ms\n", .{v.size(), (end_sort - start_sort) * 1000.0});
            try checkSorted(v.slice(), comp);
        }
    }
}