// RUN: dmz %s -run | filecheck %s

fn memset_simd(buf: []u8, val: u8) -> void {
    const vec_len = @simdSize(u8);
    let v: @simd<u8, vec_len> = @simdSplat(val);

    const iters = buf.len / vec_len;
    for (0..iters) |i| {
        v.store(&buf[i * vec_len]);
    }
    const rest = buf.len % vec_len;
    if (rest > 0) {
        for (0..rest) |i| {
            buf[iters * vec_len + i] = val;
        }
    }
}

fn memset_scalar(buf: []u8, val: u8) -> void {
    for (buf[0..buf.len]) |b| {
        b.* = val;
    }
}

extern fn memset(buf: *u8, val: u8, size: usize) -> *u8;

extern fn printf(fmt: *u8, ...) -> i32;
extern fn malloc(size: usize) -> *u8;
extern fn free(ptr: *u8) -> void;

fn main() -> void {
    const len = 1024 * 1024 + 123;
    let buf: *u8 = malloc(len);
    memset_simd(buf[0..len], 123);
    // memset_scalar(buf[0..len], 123);
    // memset(buf, 123, len);
    printf("%d %d %d\n", buf[0], buf[len / 2], buf[len - 1]);
    // CHECK: 123 123 123
    free(buf);
}